---
import type { CollectionEntry } from 'astro:content'
import StatusTag from './StatusTag.astro'

/**
 * One project, as one row of `ls -1 projects/`.
 *
 * The row is a `<tr>`, and the file name is the link. `ls` lists directory entries, so
 * the listing shows `project.id` — the markdown file's own name without `.md` — rather
 * than the `title` from its frontmatter. That is the detail that makes the command
 * above it true: `cat src/content/projects/` and the page say the same thing.
 *
 * The human title is still in the accessible name, prefixed as hidden text, so a screen
 * reader hears "Sh_Images Reborn, sh-images-reborn, link" and a sighted reader sees the
 * file name. Label in Name holds: the visible string is a suffix of the name, not a
 * replacement for it.
 *
 * TWO LINKS IN ONE ROW, and why this is a name cell and a source cell rather than one
 * stretched link. The row used to be the hit target, with the name link's `::after`
 * stretched over it — which is fine until a second destination arrives, because an
 * anchor inside an anchor is invalid HTML and both destinations break in every browser.
 * There is no way to nest, and no `z-index` makes it legal. So the stretched
 * pseudo-element is gone and the two destinations are two cells:
 *
 *   name    -> the case study, the row's reason for existing
 *   source  -> the project's first outbound link, which is its repository
 *
 * The cost is honest and worth naming: the row is no longer one large hit target, so
 * the hit area is the name text. In exchange the source is reachable, which on a
 * job-hunting site is worth more than a bigger target — a recruiter's next click is
 * almost always "let me read the code".
 *
 * Tab order is the DOM order and it is the right one: case study first, because that is
 * what the row is for, then source. Both are reachable by keyboard, and because the
 * source column is dropped with `display: none` at narrow widths rather than hidden with
 * `visibility` or `opacity`, a dropped link leaves the tab order entirely instead of
 * becoming a focus stop on an invisible anchor.
 *
 * The name cell is a `<th scope="row">`: it names the row, so it is a header, and the
 * status, the date, the stack and the source are announced against it instead of as a
 * bare list of strings. `th` is not a heading element, so this adds nothing to the page
 * outline.
 */

interface Props {
  project: CollectionEntry<'projects'>
}

const { project } = Astro.props
const { status, date, stack, links } = project.data
const href = `/projects/${project.id}`
const iso = date.toISOString().slice(0, 10)

/**
 * The first outbound link, and the only one rendered here.
 *
 * `links: []` is valid and one entry has it, so the cell has to be able to collapse
 * rather than render an empty or broken anchor. `undefined` is falsy, so the cell is
 * simply not emitted and the column is one cell shorter for that row — which is what a
 * `ls` of a directory with a file missing its metadata actually looks like. The column
 * heading collapses too: `index.astro` only emits it when at least one project has a
 * link, so an all-empty collection produces no empty column at the top of the table.
 *
 * First link only, deliberately. A row wide enough for a case study, a repository, a
 * live demo and a changelog is a row that fits on none of the widths this page has to
 * work at, and the rest are one click away on the case study itself.
 */
const source = links[0]
---

<tr class="row">
  <th scope="row" class="row__cell row__cell--name" data-col="name">
    <a class="row__link" href={href}>
      <span class="visually-hidden">{project.data.title}, </span>{project.id}
    </a>
  </th>

  <td class="row__cell row__cell--status" data-col="status">
    <StatusTag status={status} />
  </td>

  <td class="row__cell row__cell--date" data-col="date">
    <time datetime={iso}>{iso}</time>
  </td>

  <td class="row__cell row__cell--stack" data-col="stack">{stack.join(' ')}</td>

  {
    source && (
      <td class="row__cell row__cell--source" data-col="source">
        <a class="row__source" href={source.href} rel="noopener">
          {source.label}
        </a>
      </td>
    )
  }
</tr>

<style>
  .row__cell {
    vertical-align: baseline;
    white-space: nowrap;
  }

  .row__cell--name {
    text-align: start;
    font-weight: 400;
  }

  /* Underlined, not only recoloured, so the row reads as a link on a monochrome
     display and under Windows high contrast. The underline is the affordance; the
     colour is the shortcut. */
  .row__link {
    color: var(--c-text);
    font-weight: 700;
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 0.2em;
  }

  .row__link:hover {
    color: var(--c-link-hover);
  }

  /* The focus ring is the global `:focus-visible` two-tone outline, so it is a shape
     change and not a colour change, and it clears 5.15:1 even on the hover surface.
     `border-radius` only, so the ring is a crisp rectangle around the name rather than
     a pill around a whole row. */
  .row__link:focus-visible {
    border-radius: 1px;
  }

  /* A second link, a second treatment. It is not the row's subject, so it is not bold
     and it is not the content colour: it takes `--c-link`, which is a documented
     accent for exactly this and clears AA on the row's hover surface. It is underlined
     for the same reason the name is, because a link that is only a different hue is a
     link that disappears on a greyscale display. Two links in a row, two underlines,
     one of them bold — the difference is carried by weight and position, not by hue. */
  .row__source {
    color: var(--c-link);
    font-weight: 400;
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 0.2em;
  }

  .row__source:hover {
    color: var(--c-link-hover);
  }

  .row__source:focus-visible {
    border-radius: 1px;
  }

  .row__cell--date,
  .row__cell--status {
    color: var(--c-text-soft);
  }
</style>
