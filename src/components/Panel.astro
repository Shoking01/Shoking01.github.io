---
/**
 * Panel — the rounded box-drawing frame.
 *
 * The frame is a real character grid, not a CSS border with glyphs pasted on the
 * corners. That is a deliberate choice and the glyph metrics are what make it
 * possible. Measured from `JetBrainsMono[wght].ttf` (upem 1000, advance 600):
 *
 *   `─` U+2500  x -20..620  y  320..420   ink overhangs the 600 advance by 20 units
 *                                        on each side, so a run of `─` tiles seamlessly.
 *   `│` U+2502  x 250..350  y -400..1120  the stem is 0.1 em wide, dead centre in the
 *                                        cell, and 1.52 em tall. At `line-height: 1.5`
 *                                        consecutive stems overlap by 0.02 em, so a
 *                                        column of `│` is one continuous hairline.
 *   `╭ ╮ ╰ ╯`  each corner carries a 0.1 em arm on the 600 advance, so the corners
 *                                        meet the rails without a seam.
 *
 * `1.5` is therefore not an arbitrary line height — it is the only value at which
 * `│` connects. It is `--leading-chrome` in typography.css, and the two are kept
 * together deliberately.
 *
 * Width is measured in character cells via `ch`, which for a monospace face is the
 * real advance width, so `--cols: 64` means the frame is 64 characters wide. Panels
 * are capped at that width and fall back to the viewport width below it; the rails
 * are clipped rather than gapped when that happens, because a clipped `─` run is
 * still a continuous line.
 *
 * Every frame element is `aria-hidden`. The panel's content is ordinary markup.
 */

interface Props {
  /** Frame width in character cells. Omit for a panel that fills its container. */
  cols?: number
  /**
   * How far the vertical rails are allowed to run. The chain is clipped by the panel
   * height, so this only needs to exceed the tallest panel's line count.
   */
  rows?: number
  /** Surface the panel sits on. Depth comes from the elevation ramp, never a shadow. */
  surface?: 'sunken' | 'chrome' | 'page' | 'panel' | 'raised' | 'highest'
  /**
   * Body padding, block and inline. Set here rather than from the consumer because the
   * body belongs to this component: a caller reaching it has to go through a scoped
   * selector aimed at an element it does not render, which cannot match. Three callers
   * wanted different padding and all three were silently ignored. See
   * `verify-structure.mjs` check 8, which exists because of it.
   */
  padBlock?: string
  padInline?: string
  class?: string
  id?: string
}

const {
  cols,
  rows = 64,
  surface = 'panel',
  padBlock,
  padInline,
  class: className,
  id,
} = Astro.props

// Only emitted when asked for, so a panel that takes the defaults carries no inline
// style at all and keeps looking like every other panel in the markup.
const pad = [
  padBlock && `--panel-pad-block:${padBlock}`,
  padInline && `--panel-pad-inline:${padInline}`,
].filter(Boolean).join(';')

// With a known width the rails are exactly the right length. Without one they are a
// long run that the flex-free clipping in CSS trims to whatever the container is.
// Either way the visible result is one unbroken line: a `─` overhangs its cell by
// 20 units on each side, so a partial glyph is a shorter rule, never a gap.
const railLength = cols ? Math.max(cols - 2, 1) : 256
const rail = '\u2500'.repeat(railLength)
const vrail = '\u2502\n'.repeat(Math.max(rows, 1) - 1) + '\u2502'
---

<div
  class:list={['panel', `panel--${surface}`, !cols && 'panel--fluid', className]}
  style={[cols && `--cols:${cols}`, pad].filter(Boolean).join(';') || undefined}
  id={id}
>
  <span class="panel__corner panel__corner--tl" aria-hidden="true">╭</span>
  <span class="panel__rail panel__rail--top" aria-hidden="true">{rail}</span>
  <span class="panel__corner panel__corner--tr" aria-hidden="true">╮</span>

  <div class="panel__middle">
    <span class="panel__vrail panel__vrail--left" aria-hidden="true">{vrail}</span>
    <div class="panel__body">
      <slot />
    </div>
    <span class="panel__vrail panel__vrail--right" aria-hidden="true">{vrail}</span>
  </div>

  <span class="panel__corner panel__corner--bl" aria-hidden="true">╰</span>
  <span class="panel__rail panel__rail--bottom" aria-hidden="true">{rail}</span>
  <span class="panel__corner panel__corner--br" aria-hidden="true">╯</span>
</div>

<style>
  .panel {
    --panel-pad-block: 0.7em;
    --panel-pad-inline: 1ch;
    /* What the frame is painted in, and what it becomes under a pointer. See the hover
       note below for why this is a custom property and not a bare declaration. */
    --frame-idle: var(--c-frame);
    --frame-hover: var(--c-line);

    /* Exposed rather than hardcoded, and the reason is a bug that was actually live.

       `position: relative` is not decoration here: the vertical rails below are
       `position: absolute` and resolve against this box. So a panel cannot be left
       unpositioned, and a consumer that needs to take positioning over — the nav needs
       `sticky` — has no way to declare it, because Astro's scoped styles do not reach
       a child component's root element. See the note on `:global(.nav)` in
       `SiteNav.astro` for the whole of it.

       A custom property resolves on the element itself and needs no scope match, so
       this is the one extension point that works across that boundary. Default
       unchanged, so every other consumer of `Panel` is untouched. */
    position: var(--panel-position, relative);
    display: grid;
    grid-template-columns: 1ch minmax(0, 1fr) 1ch;
    grid-template-rows: auto auto auto;
    width: 100%;
    max-width: 100%;
    color: var(--c-frame);
    font-variant-ligatures: none;
    letter-spacing: normal;
  }

  /* A panel with no `cols` fills its container, which is what the nav, the footer and
     the main column want so the whole shell shares one width. */
  .panel:not(.panel--fluid) {
    max-width: min(calc(var(--cols) * 1ch), 100%);
  }

  .panel--page {
    background-color: var(--surface-page);
  }
  .panel--sunken {
    background-color: var(--surface-sunken);
  }
  .panel--chrome {
    background-color: var(--surface-chrome);
  }
  .panel--panel {
    background-color: var(--surface-panel);
  }
  .panel--raised {
    background-color: var(--surface-raised);
  }
  .panel--highest {
    background-color: var(--surface-highest);
  }

  /* THE FRAME RESPONDS TO A POINTER, and the interesting part is that the frame is TEXT.

     A panel's border is a run of `─` and a column of `│`, not a CSS border. They are
     real glyphs painted in `color`, which means a `color` transition animates the entire
     frame — every rail and both sides — without a single extra element and without
     touching layout. A `border-color` transition could not do this at all, because
     there is no border.

     `--c-frame` is `overlay0` at 2.57:1 on a panel and `--c-line` is `overlay2` at 4.45:1,
     so the hover state is a real increase in contrast and not a decorative shimmer.
     Both are below the 4.5:1 text threshold, which is correct and unchanged: the frame
     never carries text, and `verify-structure.mjs` check 3 fails the build if either is
     used AS one.

     WHY A CUSTOM PROPERTY RATHER THAN A `:hover` RULE. The obvious version is
     `.panel:hover { color: var(--c-line) }`. That would work for colour, but it puts the
     hover state on the panel element while the frame reads `color` from the same rule
     that sets it, and a consumer cannot then say what "hovered" means in its own terms.
     Two properties make the state nameable: a panel can be hovered by a pointer, and a
     card inside it can be hovered by a pointer, and the second does not have to
     reimplement the first. `ProjectCard` uses `--frame-hover` for exactly that.

     `transition` sits on the base rule so the return trip is animated too. Putting it
     on `:hover` alone means the element only transitions INTO the state and snaps back
     out, which is the single most common way a hover transition ends up feeling broken.

     THE PROPERTY LIST IS COMPLETE ON PURPOSE, and this was a bug rather than a
     decision. It read `transition: color …` alone, which is right for the frame and
     wrong for a panel that also lifts its own surface: `.panel[data-astro-cid]` weighs
     (0,2,0) and a consumer's `.card` weighs (0,1,0), so the panel's declaration won and
     the card's `transition: background-color` was discarded. The surface still changed
     colour, because a property that is not transitioned changes instantly — so the card
     lifted with a hard edge while its frame faded. Measured: `transitionProperty`
     resolved to `color` on an element whose own rule said `background-color`.

     So this list names every property a panel is allowed to animate on hover, which
     makes it the single declaration a consumer needs to inherit rather than compete
     with. `--tint-hover` exists for the same reason at the document level. */
  .panel {
    color: var(--frame-idle);
    transition: var(--tint-hover);
  }

  .panel:hover,
  .panel:focus-within {
    color: var(--frame-hover);
  }

  /* The four corners sit in single-cell columns so the rails and the vertical rules
     land on the same grid. Each is a lone glyph in a normal line box, which puts its
     ink exactly where the character grid says it should be. */
  .panel__corner,
  .panel__rail,
  .panel__vrail {
    white-space: pre;
    line-height: var(--leading-chrome);
  }

  .panel__corner--tl {
    grid-area: 1 / 1;
  }
  .panel__corner--tr {
    grid-area: 1 / 3;
  }
  .panel__corner--bl {
    grid-area: 3 / 1;
  }
  .panel__corner--br {
    grid-area: 3 / 3;
  }

  .panel__rail--top {
    grid-area: 1 / 2;
    overflow: hidden;
  }
  .panel__rail--bottom {
    grid-area: 3 / 2;
    overflow: hidden;
  }

  .panel__middle {
    /* Spans all three columns. Without this, auto-placement drops it into the first
       free cell — the 1ch corner column — and the whole frame collapses. */
    grid-area: 2 / 1 / 3 / 4;
    position: relative;
    display: grid;
    grid-template-columns: 1ch minmax(0, 1fr) 1ch;
  }

  /* Absolute, so the 64-line chain never contributes height to the row. It is clipped
     by the panel instead, and since every `│` stem overhangs its line box, clipping
     can only shorten the last stem — it can never open a gap.

     `top`/`bottom` are 0, not the body's block padding. A `│` is a continuous hairline
     first and a per-line marker second: insetting it by the padding left a visible
     break between the top rail and the first stem, and between the last stem and the
     bottom rail. */
  .panel__vrail {
    position: absolute;
    top: 0;
    bottom: 0;
    width: 1ch;
    overflow: hidden;
  }
  .panel__vrail--left {
    left: 0;
  }
  .panel__vrail--right {
    right: 0;
  }

  .panel__body {
    grid-area: 1 / 2;
    padding-block: var(--panel-pad-block);
    /* One cell of breathing room inside the vertical rule on each side. Padding, not
       margin, so the grid track stays `cols - 2` cells wide and the rails still meet
       the corners. Settable through the `padInline` prop. */
    padding-inline: var(--panel-pad-inline);
    color: var(--c-text);
  }
</style>
