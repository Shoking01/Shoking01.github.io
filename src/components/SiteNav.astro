---
import Panel from './Panel.astro'
import { site } from '../site.config'

/**
 * The nav is a nav.
 *
 *   Adrián Quirós                                    projects   about
 *
 * It used to be a shell prompt with a numbered command history under it. The grammar
 * was a static map of the session dressed as a record of one, and it is gone: a
 * portfolio that pretends to be a terminal is a portfolio about pretending to be a
 * terminal. What survives is the part that was load-bearing — a framed panel on the
 * `mantle` rung of the ramp, chrome-sized type, a real `<a href>` for every
 * destination, and the current page marked on a real anchor.
 *
 * THE BRAND IS THE HOME LINK, and there is deliberately no separate "home" item. Two
 * links to `/` on one line is one destination stated twice, and it makes
 * `aria-current="page"` ambiguous: the attribute would have to be true on both, or on
 * one of them and false on an identical link a centimetre away, which teaches a screen
 * reader that the attribute means "one of these". So the owner's name is the way home
 * and the two items beside it are the sections that are not.
 *
 * `aria-current` IS ON A REAL ANCHOR, which is the same argument the old prompt link
 * made and the reason it still holds: an element that only LOOKS current is a current
 * page for sighted users and nothing at all for everyone else. The current item is
 * marked with weight and an underline as well as colour, so the state survives a
 * monochrome display, Windows high contrast and a greyscale print.
 *
 * A CASE STUDY MARKS NOTHING, and that is the honest outcome rather than a gap. The
 * reader is in none of the two nav destinations — they are in a document those
 * destinations point at. The case study carries its own breadcrumb with
 * `aria-current="page"` on its own title, so the page still says where it is in the
 * hierarchy; claiming "projects" here would put `aria-current` on a link whose `href`
 * goes somewhere else, which is worse than saying nothing.
 *
 * There is still no `Last login:`, no uptime and no `$?` here, and the reason has not
 * changed: the server has a request, not a session. Every line in this component is a
 * fact about the document being served or about where it links, and nothing on this
 * page claims to be a fact about the visitor.
 *
 * `site` is imported for `name` only. The old prompt derived a login name from it and
 * that derivation lived in one place; with the prompt gone there is nothing left to
 * derive, so this file takes the name as written and does not re-case it.
 */

interface Route {
  /** Where it goes. A real `href`, so deep links, the back button and `ClientRouter`
      all keep working exactly as they did. */
  href: string
  /** Plain English, because a destination is not something a screen reader can read out
      of an icon. */
  label: string
  /**
   * The pathname that makes this route the current one, or `undefined` when it cannot
   * be current.
   *
   * `projects` points at a fragment of the home page, and a fragment is not a document:
   * `/#projects` while you are on `/` means "somewhere on this page", not "this is the
   * page you are on". Marking it current would put `aria-current="page"` on a link
   * that does not lead to the document being viewed.
   */
  current?: string
}

const ROUTES: Route[] = [
  { href: '/#projects', label: 'projects' },
  { href: '/about', label: 'about', current: '/about' },
]

const pathname = Astro.url.pathname.replace(/\/+$/, '') || '/'
const isHome = pathname === '/'

/** The brand doubles as the home link, so it is current on `/` and nowhere else. */
function isCurrent(route: Route): boolean {
  return route.current === pathname
}
---

<Panel surface="chrome" class="nav">
  <nav class="nav__row" aria-label="Main">
    <a class="nav__brand" href="/" aria-current={isHome ? 'page' : undefined}>{site.name}</a>

    <ul class="nav__list" role="list">
      {
        ROUTES.map((route) => (
          <li>
            <a
              class="nav__link"
              href={route.href}
              aria-current={isCurrent(route) ? 'page' : undefined}
            >
              {route.label}
            </a>
          </li>
        ))
      }
    </ul>
  </nav>
</Panel>

<style>
  .nav {
    position: sticky;
    top: 0;
    z-index: 3;
  }

  /* One row, brand against destinations, spread to the full width of the frame. The
     panel is the same fluid width as the shell, so the nav's left edge is the main
     column's left edge and the two stack on the grid rather than merely near it. */
  .nav__row {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.4em 2ch;
    font-size: var(--text-sm);
  }

  /* The one place the name is set at chrome body size rather than at `--text-sm`. It is
     the site's identity rather than one of its destinations, so it gets the accent and
     one step of weight, and the current-page underline underneath it does the rest. */
  .nav__brand {
    color: var(--c-accent);
    font-size: var(--text-base);
    font-weight: 700;
    text-decoration: none;
  }

  .nav__brand:hover {
    color: var(--c-link-hover);
    text-decoration: underline;
  }

  .nav__brand[aria-current] {
    color: var(--c-text);
  }

  /* `role="list"` is not decoration: `list-style: none` makes Safari drop list
     semantics entirely, and this is the site's primary navigation. */
  .nav__list {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4em 2.5ch;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  /* `--c-text-soft`, and not the muted ramp: the nav sits on `chrome`, which is darker
     than the page, and `subtext1` measures 9.26:1 there. Quiet enough to read as
     navigation, legible enough to be a link. */
  .nav__link {
    color: var(--c-text-soft);
    text-decoration: none;
  }

  .nav__link:hover {
    color: var(--c-link-hover);
    text-decoration: underline;
  }

  /* Weight AND underline, so the current page is a shape change and not only a colour
     change. `border-radius: 1px` so the global two-tone focus ring is a crisp
     rectangle around the word rather than a pill. */
  .nav__link[aria-current] {
    color: var(--c-text);
    font-weight: 700;
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 0.2em;
  }

  .nav__link:focus-visible,
  .nav__brand:focus-visible {
    border-radius: 1px;
  }
</style>
