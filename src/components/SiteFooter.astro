---
import Panel from './Panel.astro'
import { site } from '../site.config'

/**
 * The footer is a framed status line. It sits on `crust`, the darkest rung of the
 * elevation ramp, which is what a terminal prompt does: chrome recedes, content sits
 * forward.
 */

const year = new Date().getFullYear()
const links = site.links.filter((link) => link.href.length > 0)
---

<Panel surface="sunken" class="footer">
  <div class="footer__row">
    <p class="footer__line">
      <span class="footer__prompt" aria-hidden="true">~/portfolio</span>
      <span class="footer__sep" aria-hidden="true">│</span>
      <span>© {year} {site.name}</span>
    </p>

    {
      links.length > 0 && (
        <ul class="footer__links" aria-label="Elsewhere">
          {links.map((link) => (
            <li>
              <a class="footer__link" href={link.href} rel="me noopener">
                {link.label}
              </a>
            </li>
          ))}
        </ul>
      )
    }
  </div>
</Panel>

<style>
  /* The same teal wash the nav carries, mirrored so the accent reads as coming from the
     edge of the viewport rather than from the middle of the page. `--wash-chrome` is
     measured in `tokens.css`, including the contrast it preserves for the footer's own
     `subtext0` links at 6.79:1.

     Mirrored, not identical: the nav's gradient fades downward from the top and this one
     fades upward from the bottom, so the two bands frame the content instead of both
     bleeding inward from the same direction. Not animated, for the same reason the nav's
     is not, and for the same reason it costs nothing: the footer does not move. */
  /* `:global` on both halves, for the same reason as the nav's: the element is `Panel`'s
     root and carries `Panel`'s scope id, so a scoped `.footer` in front of it would
     compile to a compound matching nothing. */
  :global(.footer) :global(.panel__body) {
    background-image: linear-gradient(to top, var(--wash-chrome), transparent 72%);
  }

  /* `:global`, because `Panel` renders this element and a scoped `.footer` could never
     match it — so `margin-block-start: auto` was doing nothing and the footer was not
     being pushed to the bottom of the shell. Unlike the padding cases this one is safe
     to express as a selector: nothing else declares a `margin` on a panel, so there is
     no specificity tie to lose. `verify-structure.mjs` check 8 is what flagged it. */
  :global(.footer) {
    margin-block-start: auto;
  }

  .footer__row {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.5ch 2ch;
    font-size: var(--text-sm);
  }

  .footer__prompt {
    color: var(--c-text-soft);
  }

  /* A `│` from the box-drawing face, used as a separator inside a line of text. */
  .footer__sep {
    color: var(--c-frame);
    margin-inline: 0.5ch;
  }

  .footer__links {
    display: flex;
    flex-wrap: wrap;
    gap: 2ch;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .footer__link {
    color: var(--c-text-soft);
    text-decoration: none;
    transition: var(--tint-hover);
  }

  .footer__link:hover {
    color: var(--c-link-hover);
    text-decoration: underline;
  }
</style>
