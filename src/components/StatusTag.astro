---
/**
 * Lifecycle state, rendered four ways at once.
 *
 *   active        + active        green
 *   maintenance   ~ maintenance   yellow
 *   archived      - archived      dimmed
 *
 * The colour is the least load-bearing of these, and it is there to make the other
 * three quicker to parse, not to carry the meaning — which is the point of pairing
 * them.
 *
 * THE SEGMENT METER IS NOT A PROGRESS BAR, and the difference is the whole reason it
 * can exist honestly. `status` is a three-value enum in `content.config.ts`, a
 * lifecycle flag rather than a scale: there is no field anywhere in the schema for a
 * percentage, a phase or a completion figure, and both projects sit at `active`
 * regardless of how finished either one is. A bar that filled to 60% would therefore
 * be a graphic that asserts a number the data does not contain, on a site whose
 * argument is that its numbers are real. That is the same class of mistake as the
 * `shipped / in progress` split that `index.astro` rejected earlier.
 *
 * What the segments DO encode is the flag itself. Three segments, one per state, and
 * the filled one is the state this project is in: three for `active`, two for
 * `maintenance`, one for `archived`. It is a discrete readout rather than a magnitude,
 * and it is derived from the same `MAP` the word and the glyph come from, so it cannot
 * disagree with them.
 *
 * `aria-hidden`, because the word beside it already states the state and a screen
 * reader announcing "3 of 3 segments filled, active" would be a second, worse way of
 * saying it. The meter is the glanceable half of the pairing; the word is the one
 * that survives without colour.
 *
 * The glyphs are ASCII on purpose. `✓` and `✗` live in U+2713 and U+2717, which are
 * outside both declared font faces, so they would silently fall back to a system font.
 * `+ ~ -` are in the latin subset and always render as JetBrains Mono.
 */

const MAP = {
  active: { glyph: '+', label: 'active', token: '--c-state-active', filled: 3 },
  maintenance: { glyph: '~', label: 'maintenance', token: '--c-state-maintenance', filled: 2 },
  archived: { glyph: '-', label: 'archived', token: '--c-state-archived', filled: 1 },
} as const

const TOTAL = 3

interface Props {
  status: keyof typeof MAP
}

const { status } = Astro.props
const state = MAP[status]

/** One entry per segment, built from the enum rather than typed per project. */
const segments = Array.from({ length: TOTAL }, (_, i) => i < state.filled)
---

<span class:list={['status', `status--${status}`]}>
  <span class="status__meter" aria-hidden="true">
    {
      segments.map((on) => (
        <span class:list={['status__seg', on && 'status__seg--on']} />
      ))
    }
  </span>
  <span class="status__glyph" aria-hidden="true">{state.glyph}</span>
  <span class="status__label">{state.label}</span>
</span>

<style>
  .status {
    display: inline-flex;
    align-items: center;
    gap: 0.4ch;
    font-size: var(--text-micro);
    text-transform: uppercase;
    letter-spacing: var(--tracking-label);
    white-space: nowrap;
  }

  /* The state colour is applied through a custom property on each state rather than by
     three separate `color` declarations. The token is named for the STATE, so the hue
     lives in exactly one place — `tokens.css` — and this file never mentions a palette
     name at all. Swapping the whole lifecycle palette is one edit there.
     `currentColor` then flows from here into the meter's filled segments, so the bars
     and the word cannot end up different colours. */
  .status--active {
    color: var(--c-state-active);
  }
  .status--maintenance {
    color: var(--c-state-maintenance);
  }
  .status--archived {
    color: var(--c-state-archived);
  }

  /* The unfilled segments are not invisible, which is what makes this a three-step
     readout rather than two pixels of colour. `--c-frame` on the card's own surface
     measures 2.57:1, and WCAG 1.4.11 exempts it: it is a decorative boundary, the
     state is carried by the word and the glyph beside it, and the whole meter is
     `aria-hidden`. */
  .status__meter {
    display: inline-flex;
    gap: 1px;
    margin-inline-end: 0.5ch;
  }

  .status__seg {
    width: 2px;
    height: 0.85em;
    background-color: var(--c-frame);
    /* `currentColor` on the filled ones so the meter takes the state's colour without
       a second rule per state; the parent already sets it. */
    transition: background-color var(--dur-hover) var(--ease-step);
  }

  .status__seg--on {
    background-color: currentColor;
  }

  .status__glyph {
    font-weight: 700;
  }
</style>