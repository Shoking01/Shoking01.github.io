---
import { site } from '../site.config'

/**
 * Per-page document metadata.
 *
 * Three rules, and they are the reason this is a component rather than a paragraph of
 * tags in the layout:
 *
 *   1. `title`, `description` and `canonical` are required. A page cannot render
 *      without them, so there is no default that silently ships an empty description
 *      to a crawler.
 *   2. Every Open Graph and Twitter tag is derived from the same three values. There
 *      is no second copy of the description to forget to update, which is the usual
 *      way social cards end up disagreeing with the page.
 *   3. The canonical URL is resolved against `site.url`, so it is absolute. A relative
 *      canonical is not a canonical.
 *
 * `og:image` IS PRESENT, and the earlier reason for its absence is retired rather than
 * quietly deleted. It was omitted because every crawler that matters renders JPEG, PNG
 * or WebP and drops an SVG, and producing a raster would have meant an image pipeline in
 * a static site for one asset. That objection was answered by rendering the asset ONCE,
 * offline, with a throwaway script, and committing the result — so the pipeline exists
 * but it is not a build dependency, the file is reviewable in a diff, and the site still
 * ships no image tooling.
 *
 * The card is 1200x630 at 11KB: a near-white S in `text` on `crust`, under a `mauve`
 * rule, set in JetBrains Mono. It is derived from the same palette as the tokens rather
 * than from a second set of brand colours. Every crawler that dropped the SVG reads this
 * file instead.
 *
 * `twitter:card` moves to `summary_large_image` for the same reason it was not before:
 * there is now a large image to ask for.
 *
 * The dimensions are declared because a crawler that has to fetch the image still
 * reserves the right aspect ratio up front, and an undeclared image makes the preview
 * jump when it arrives.
 */

interface Props {
  title: string
  description: string
  /** Open Graph object type. `article` on a case study, `website` on a listing page. */
  type?: 'website' | 'article'
  /** ISO date, for `article:published_time`. Omitted when absent. */
  publishedTime?: string
}

const { title, description, type = 'website', publishedTime } = Astro.props

const canonical = new URL(Astro.url.pathname, site.url).href
const ogImage = new URL('/og.png', site.url).href
---

<title>{title}</title>
<meta name="description" content={description} />
<link rel="canonical" href={canonical} />

<meta property="og:type" content={type} />
<meta property="og:site_name" content={site.name} />
<meta property="og:locale" content={site.locale.replace('-', '_')} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonical} />
<meta property="og:image" content={ogImage} />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta property="og:image:alt" content={`${site.name} — ${site.role}`} />
{type === 'article' && <meta property="article:author" content={site.name} />}
{publishedTime && <meta property="article:published_time" content={publishedTime} />}

<!-- `summary_large_image` because there is now a 1200x630 image to ask for. -->
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={ogImage} />
