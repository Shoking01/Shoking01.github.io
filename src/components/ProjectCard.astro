---
import type { CollectionEntry } from 'astro:content'
import Panel from './Panel.astro'
import StatusTag from './StatusTag.astro'

/**
 * One project, as a framed card.
 *
 * The card is chrome, so it keeps the frame. The title is the link, and it is the
 * only link: a card with a title link, a "read more" link and a wrapped click target
 * gives a keyboard user three ways to do one thing. The arrow is ASCII `>` because
 * U+2192 is outside both font faces.
 */

interface Props {
  project: CollectionEntry<'projects'>
  /** Card width in character cells. */
  cols?: number
}

const { project, cols } = Astro.props
const { title, summary, date, status, stack, links, featured } = project.data
const href = `/projects/${project.id}`
const iso = date.toISOString().slice(0, 10)
---

<Panel cols={cols} class="card">
  <article class="card__inner">
    <header class="card__head">
      <h3 class="card__title">
        <a class="card__link" href={href}>
          {title}
        </a>
      </h3>
      <StatusTag status={status} />
    </header>

    {featured && <p class="card__flag">featured</p>}

    <p class="card__summary">{summary}</p>

    <footer class="card__meta">
      <span class="card__date">
        <time datetime={iso}>{iso}</time>
      </span>

      {
        stack.length > 0 && (
          <ul class="card__stack">
            {stack.map((item) => (
              <li class="card__tech">{item}</li>
            ))}
          </ul>
        )
      }

      <span class="card__more" aria-hidden="true">&gt;</span>
    </footer>
  </article>

  {
    links.length > 0 && (
      <ul class="card__links">
        {links.map((link) => (
          <li>
            <a class="card__link-out" href={link.href} rel="noopener">
              {link.label}
            </a>
          </li>
        ))}
      </ul>
    )
  }
</Panel>

<style>
  .card {
    color: var(--c-text);
  }

  .card__inner {
    display: grid;
    gap: 0.6em;
  }

  .card__head {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.25em 2ch;
  }

  .card__title {
    font-size: var(--text-lg);
    font-weight: 700;
    line-height: 1.3;
  }

  /* The title is the link, and it is underlined rather than only recoloured so the
     affordance survives a monochrome display. */
  .card__link {
    color: var(--c-text);
    text-decoration-color: var(--c-line);
    text-underline-offset: 0.25em;
  }

  .card__link:hover {
    color: var(--c-link-hover);
    text-decoration-color: var(--c-link-hover);
  }

  .card__flag {
    font-size: var(--text-micro);
    text-transform: uppercase;
    letter-spacing: var(--tracking-label);
    color: var(--c-accent);
  }

  .card__summary {
    color: var(--c-text-soft);
    max-width: 62ch;
  }

  .card__meta {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.4em 2ch;
    font-size: var(--text-sm);
    color: var(--c-text-muted);
  }

  .card__stack {
    display: flex;
    flex-wrap: wrap;
    gap: 1.5ch;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .card__tech::before {
    content: '#';
    color: var(--c-line);
  }

  .card__more {
    margin-inline-start: auto;
    color: var(--c-accent);
    font-weight: 700;
  }

  .card__links {
    display: flex;
    flex-wrap: wrap;
    gap: 2ch;
    margin: 0.8em 0 0;
    padding: 0.8em 0 0;
    list-style: none;
    border-block-start: 1px solid var(--c-line-subtle);
    font-size: var(--text-sm);
  }

  .card__link-out {
    color: var(--c-text-soft);
  }

  .card__link-out:hover {
    color: var(--c-link-hover);
  }
</style>
