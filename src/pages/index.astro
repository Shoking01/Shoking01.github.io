---
import { createRequire } from 'node:module'

import { getCollection } from 'astro:content'

import BaseLayout from '../layouts/BaseLayout.astro'
import AsciiRule from '../components/AsciiRule.astro'
import Panel from '../components/Panel.astro'
import ProjectCard from '../components/ProjectCard.astro'
import { skillGroups } from '../data/skills'
import { site } from '../site.config'

/**
 * Home. Who this is, what it is made of, and what has been built.
 *
 * THE VISUAL LANGUAGE IS NOT THE SIMULATION. The rounded frames, the monospace grid,
 * the `ch` discipline, the elevation ramp and the `#` marker are the identity and all of
 * them stay. What is gone is the theatre: the `user@host:~$` prompt, the command names,
 * the numbered history, the `ls` table, and the blinking caret. A page that pretends to
 * be a terminal is a page about pretending to be a terminal, and this one has enough to
 * say without it. What is left is a site that looks the way it was built and reads like
 * a portfolio rather than a transcript.
 *
 * THE ORDER IS STILL THE ARGUMENT: who I am, what this is made of, what I have built.
 * The facts block sits in the middle because it is the transition — the point where the
 * page stops being a claim about a person and starts being evidence. Every value in it
 * is measured at build time, which is the only reason it is allowed to exist at all.
 *
 * There is no project data in this file. `getCollection` reads every markdown file in
 * `src/content/projects/`, so adding a project adds a card here without touching this
 * page — which is the whole point of the content layer.
 *
 * Sort order is `featured` first, then the author's `order`, then newest first. The
 * tiebreak matters: two projects with the same `order` should not swap places between
 * builds.
 */

const projects = (await getCollection('projects')).sort(
  (a, b) =>
    Number(b.data.featured) - Number(a.data.featured) ||
    a.data.order - b.data.order ||
    b.data.date.valueOf() - a.data.date.valueOf(),
)

const hasProjects = projects.length > 0

/**
 * The intro, in prose. Written, and marked as written.
 *
 * `site.tagline` above it is the one line this page was built around, and these three
 * sentences are the first thing a reader meets in full. Every claim in them is already
 * stated somewhere on this site or derivable from it: the span from the two projects
 * and the skills taxonomy, the debugging angle from the tagline and the about page, the
 * measurable constraints from the case studies themselves. Nothing here is a new fact,
 * which is the only reason prose is safe to write on a page whose argument is that its
 * numbers are real.
 *
 * TODO(you): drafted from those same sources rather than written by you. Three sentences
 * of English on the front page, and they are yours to rewrite.
 */
const intro = [
  'I build for the web and I write native Rust, and to me those are the same job: work out what a system is actually doing before you change anything. The years in technical support and root-cause analysis are where that habit came from. Most of what I have debugged, I had to reach from the outside first, which is a slow way to learn and a fast one to keep.',
  'The projects below are the evidence rather than the pitch. What they share is that the constraints are measurable — a folder of four thousand images has a memory budget, a decode budget that is a real setting rather than a placeholder, and a coverage figure that was read off the report instead of copied out of a README.',
]

/* ------------------------------------------------------------------ *
 * The facts block. Every value below is measured, not typed.
 *
 * The rule for this block is that it must not be able to drift. A version number
 * written into a template is a lie the day somebody runs `pnpm upgrade` and forgets
 * this file, and a version number written by hand into a metadata line is the single
 * most forgettable string on a portfolio site. So every figure is read at build time
 * from the thing it describes, and a value that cannot be read is OMITTED — the line
 * it belonged on disappears rather than printing a plausible guess. A block that lies
 * about its own toolchain is worse than one that says less.
 * ------------------------------------------------------------------ */

/**
 * Astro's own version, from the RESOLVED package rather than from this repository's
 * `package.json` range. `astro: "^7.3.5"` is a range, and `7.9.0` satisfies it, so
 * printing the range would print a caret. `require` resolves through the exports map
 * and lands on the one version that was actually compiled, which is the number the
 * reader cares about. `astro/package.json` is an explicit subpath in Astro's exports,
 * so this is a supported entry point and not a reach into private internals.
 */
function resolvedVersion(specifier: string): string | undefined {
  try {
    return createRequire(import.meta.url)(specifier).version as string | undefined
  } catch {
    return undefined
  }
}

const astroVersion = resolvedVersion('astro/package.json')

/** Node and the platform, from the process doing the build. Cannot be wrong. */
const nodeVersion = process.versions.node
const platform = `${process.platform} ${process.arch}`

/**
 * The package manager that ran this build, from its own `user-agent` string.
 *
 * `pnpm` writes `pnpm/12.5.1 npm/? node/? win32 x64` into the environment for its own
 * child processes, so the manager is derived rather than assumed — which matters,
 * because a repository's lockfile name is a convention and the user agent is a fact
 * about the machine that produced the bytes. It is `undefined` when the build was not
 * run through a package manager, and then the segment is dropped, not faked.
 */
const packageManager = /^(?<name>[a-z]+)\/(?<version>\d[\w.+-]*)/.exec(
  process.env.npm_config_user_agent ?? '',
)?.groups

const toolchainLine = [
  astroVersion && `astro ${astroVersion}`,
  packageManager && `${packageManager.name} ${packageManager.version}`,
]
  .filter(Boolean)
  .join(' · ')

/**
 * `2 · active 2 · other 0`, computed from the same `getCollection` result the cards
 * below render, so the two cannot disagree.
 *
 * `other` is `total - active` and covers `maintenance` and `archived`, the other two
 * states in the schema. It is printed even at zero: a count of zero is information
 * (nothing is archived), and a segment that appears and disappears as projects land
 * makes the line harder to read across two visits than a fixed shape.
 *
 * NOT `shipped 1 · in progress 1`, which is what a summary block wants to say. `status`
 * is a lifecycle flag and it cannot tell a released project from an unreleased one:
 * Sh_Images Reborn is finished and shipped and is still `status: active`, because
 * `active` means maintained, not launched. A shipped/in-progress split would have to be
 * typed by hand per project, and a hand-typed count on a page whose whole argument is
 * that the numbers are real is the one thing this block must not do.
 */
const activeCount = projects.filter((project) => project.data.status === 'active').length

const projectsLine = `${projects.length} · active ${activeCount} · other ${projects.length - activeCount}`

/**
 * The technologies the site actually claims, derived from two existing sources rather
 * than typed: the curated `Native & systems` skill group, intersected with every
 * technology any shipped project actually uses.
 *
 * The intersection is the point. Either source alone is a claim that can go stale —
 * the skills taxonomy lists `Linux`, `Networking` and `Virtualization` for roles the
 * projects do not evidence, and the project stacks list `proptest`, which is a test
 * harness rather than a focus. What survives is what the owner has grouped as native
 * and systems work AND has actually built, so adding a Rust project cannot leave the
 * line claiming Rust is absent, and adding a Linux project cannot silently add a focus
 * that has not been written up.
 *
 * Both sides are already display-form (`skills.ts` holds `GPUI`, not `gpui`), so the
 * line reads the way the about page reads. If the group is ever renamed, the line goes
 * away instead of printing half of something.
 */
const stackUsed = new Set(projects.flatMap((project) => project.data.stack.map((s) => s.toLowerCase())))

const focusLine = (skillGroups.find((group) => group.label === 'Native & systems')?.items ?? [])
  .filter((item) => stackUsed.has(item.toLowerCase()))
  .join(' · ')

/**
 * The block as label/value pairs, each line dropped if its value could not be derived.
 * The separator is U+00B7 MIDDLE DOT, inside the declared unicode ranges, which the
 * arrow and the check mark this design used to reach for are not.
 *
 * `Built` is PROVENANCE, not a version number for the site: it is the toolchain that
 * compiled this page. `Toolchain` is the reproduction recipe — the same Astro version
 * named, next to the package manager. They look like a duplicate and are not: one says
 * what built the bytes, the other says what to install to build them again. If that
 * distinction is not worth the two lines, the Astro version on either one of them is
 * the thing to cut.
 */
const facts: { label: string; value: string }[] = [
  {
    label: 'Built',
    value: [astroVersion, nodeVersion && `Node ${nodeVersion}`, platform].filter(Boolean).join(' · '),
  },
  { label: 'Toolchain', value: toolchainLine },
  { label: 'Projects', value: projectsLine },
  { label: 'Focus', value: focusLine },
].filter((row) => row.value.length > 0)

/**
 * What the owner is doing right now, in one sentence.
 *
 * Both halves are already stated on this site rather than asserted here: Sh_Images
 * Reborn is a finished, released viewer that is `status: active` and still being
 * maintained, and Sh_Nexus says in its own words that it is in progress. The line is
 * written, not derived — `status: active` cannot tell a finished project from an
 * unfinished one, so there is nothing in the collection to compute this from.
 *
 * It is deliberately the quietest line in the intro: chrome size on the muted ramp, no
 * status light and no "available for work" badge, because whether the owner wants to
 * advertise availability is a decision he has not made yet. The intro is unframed, so
 * the surface here is `base`, where `subtext0` measures 7.37:1.
 */
const now =
  'maintaining a released desktop image viewer, and building a chat client and server alongside it.'
---

<BaseLayout title={`${site.name} — ${site.role}`} description={site.tagline}>
  <div class="page">
    <header class="intro">
      <h1 class="intro__name">{site.name}</h1>
      <p class="intro__role">{site.role}</p>
      <p class="intro__tagline">{site.tagline}</p>

      <div class="intro__body">
        {intro.map((paragraph) => (
          <p class="intro__para">{paragraph}</p>
        ))}
      </div>

      <p class="now">
        <span class="now__label">currently</span>
        <span class="now__sep" aria-hidden="true">│</span>
        <span class="now__text">{now}</span>
      </p>
    </header>

    <section class="section" id="facts">
      <AsciiRule as="div" cols={200} />
      <h2 class="section__title">Facts</h2>

      <Panel surface="panel" class="facts">
        <dl class="facts__list">
          {
            facts.map((row) => (
              <Fragment>
                <dt class="label">{row.label}</dt>
                <dd class="facts__value">{row.value}</dd>
              </Fragment>
            ))
          }
        </dl>
      </Panel>
    </section>

    <section class="section" id="projects">
      <AsciiRule as="div" cols={200} />
      <h2 class="section__title">Projects</h2>

      {
        hasProjects ? (
          <ul class="cards" role="list">
            {projects.map((project) => (
              <li>
                <ProjectCard project={project} />
              </li>
            ))}
          </ul>
        ) : (
          <p class="cards__note">
            No projects yet. Create one markdown file in <code>src/content/projects/</code>.
          </p>
        )
      }
    </section>
  </div>
</BaseLayout>

<style>
  /* ---- The page ---------------------------------------------------------------
     A stack of three blocks with a real gap between them, sized in the chrome's own
     leading so the vertical rhythm belongs to the character grid rather than to a
     guessed pixel value. Each block is a grid, because a block's heading and its
     content are two rows of one thing rather than two elements that happen to be
     adjacent. */
  .page {
    --block-gap: calc(var(--leading-chrome) * 2em);

    display: grid;
    row-gap: var(--block-gap);
  }

  .section {
    display: grid;
  }

  /* A bare rule, then the heading, then the content. The rule is the section break and
     the heading is the label, which is the same grammar `.prose h2` uses, so a section
     on this page and a section inside a case study read as one family. The rule's `cols`
     is a cap rather than a width — 200 is past any shell this site will ever render, so
     `min(200ch, 100%)` resolves to `100%` and the rule always spans the content column
     without this file having to know what `--shell-cols` is. */
  .section :global(.rule) {
    margin-block-end: 0.7em;
  }

  /* 28px, uppercase and tracked. The size step is real; case, weight and tracking are
     what make it a heading on a greyscale display, which is why all four are here. */
  .section__title {
    font-size: var(--text-xl);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: var(--tracking-label);
    line-height: 1.25;
    margin-block-end: 1.2em;
  }

  /* ---- The intro -------------------------------------------------------------
     Unframed, because this is the reading part of the page and the frame belongs to the
     chrome. The name is the only 52px on the site: it is the one line that has to
     carry the page, and a second line at that size would stop it being the first. */
  .intro {
    display: grid;
  }

  .intro__name {
    font-size: var(--text-hero);
    font-weight: 700;
    line-height: 1.1;
  }

  /* 24px and the accent, which is the same step a card title takes. The role is a
     label, not a headline, and letting it grow with the display scale would put two
     competing headlines at the top of the page. */
  .intro__role {
    font-size: var(--text-lg);
    color: var(--c-accent);
    line-height: 1.3;
  }

  /* The tagline, still the one line it has always been, as the subline under the role.
     Same size as the prose below it and told apart by colour and by a narrower measure
     — a size step here would make the tagline a third headline. */
  .intro__tagline {
    margin-block-start: 0.7em;
    font-size: var(--text-prose);
    line-height: var(--leading-prose);
    color: var(--c-text-soft);
    max-width: var(--measure-lede);
  }

  .intro__body {
    display: grid;
    row-gap: 1.25em;
    margin-block-start: 1.6em;
  }

  .intro__para {
    font-size: var(--text-prose);
    line-height: var(--leading-prose);
    color: var(--c-text);
    max-width: var(--measure-prose);
  }

  /* Three tracks, not a sentence with a `│` in it. That is the whole trick behind the
     wrapped continuation: the text is its own grid item, so when it wraps at the
     measure, the second line starts under the FIRST CHARACTER of the text instead of
     under the label. A `│` between two inline spans would wrap to column zero. */
  .now {
    display: grid;
    grid-template-columns: max-content max-content minmax(0, 1fr);
    align-items: baseline;
    margin-block-start: 1.4em;
    font-size: var(--text-sm);
    color: var(--c-text-muted);
    max-width: var(--measure-prose);
  }

  .now__label {
    text-transform: uppercase;
    letter-spacing: var(--tracking-label);
  }

  .now__sep {
    color: var(--c-frame);
    margin-inline: 0.5ch;
  }

  /* ---- Facts -----------------------------------------------------------------
     Framed, because it is a block of values rather than reading, and because the frame
     is what makes four short lines look like a panel instead of a stray list. */
  .facts :global(.panel__body) {
    padding-block: 1em;
    padding-inline: 1.5ch;
  }

  /* `dt` and `dd` as direct grid items rather than wrapped in a pair element, so one
     template aligns every label and every value down the block. A wrapper per pair
     would give each pair its own `max-content` track and the values would step in and
     out with their labels — the same reasoning the experience page uses for its own
     metadata. `max-content` for the label track is what makes the second column line up
     under `Built` without the label widths being hardcoded: the widest label sets the
     track, and a longer label would widen it rather than collide. */
  .facts__list {
    display: grid;
    grid-template-columns: max-content minmax(0, 1fr);
    gap: 0.25em 2ch;
    /* The same size as the value, so the block reads as four lines of a table rather
       than as a definition list with a caption. Labels are still quieter than values,
       and both clear AA on `surface0`: `subtext0` measures 5.65:1 there and the frame
       bounds the block to that surface. */
    font-size: var(--text-sm);
  }

  .facts__value {
    margin: 0;
    color: var(--c-text-soft);
  }

  /* ---- Projects --------------------------------------------------------------
     One column, full width: at 88 shell cells and 20px prose, two columns would give
     each summary about 31 characters, and 31 characters is not a sentence. The card
     explains the rest. `role="list"` is not decoration — `list-style: none` makes Safari
     drop list semantics entirely, and this list is the page's content. */
  .cards {
    display: grid;
    row-gap: 2ch;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  /* For whoever runs the site, not for whoever reads it. */
  .cards__note {
    font-size: var(--text-sm);
    color: var(--c-text-muted);
  }
</style>
