---
import { createRequire } from 'node:module'

import { getCollection } from 'astro:content'

import BaseLayout from '../layouts/BaseLayout.astro'
import AsciiRule from '../components/AsciiRule.astro'
import Panel from '../components/Panel.astro'
import ProjectCard from '../components/ProjectCard.astro'
import { skillGroups } from '../data/skills'
import { site } from '../site.config'

/**
 * Home. Who this is, what it is made of, and what has been built.
 *
 * THE VISUAL LANGUAGE IS NOT THE SIMULATION. The rounded frames, the monospace grid,
 * the `ch` discipline, the elevation ramp and the `#` marker are the identity and all of
 * them stay. What is gone is the theatre: the `user@host:~$` prompt, the command names,
 * the numbered history, the `ls` table, and the blinking caret. A page that pretends to
 * be a terminal is a page about pretending to be a terminal, and this one has enough to
 * say without it. What is left is a site that looks the way it was built and reads like
 * a portfolio rather than a transcript.
 *
 * THE ORDER IS STILL THE ARGUMENT: who I am, what this is made of, what I have built.
 * The facts block sits in the middle because it is the transition — the point where the
 * page stops being a claim about a person and starts being evidence. Every value in it
 * is measured at build time, which is the only reason it is allowed to exist at all.
 *
 * There is no project data in this file. `getCollection` reads every markdown file in
 * `src/content/projects/`, so adding a project adds a card here without touching this
 * page — which is the whole point of the content layer.
 *
 * Sort order is `featured` first, then the author's `order`, then newest first. The
 * tiebreak matters: two projects with the same `order` should not swap places between
 * builds.
 */

const projects = (await getCollection('projects')).sort(
  (a, b) =>
    Number(b.data.featured) - Number(a.data.featured) ||
    a.data.order - b.data.order ||
    b.data.date.valueOf() - a.data.date.valueOf(),
)

const hasProjects = projects.length > 0

/**
* The intro, in prose. Translated, not drafted.
 *
 * PROVENANCE. Every claim here came from the owner answering two questions, not from
 * inference, and the previous version of this text was a guess dressed as a claim:
 *
 *   1. The three-beat performance line is his. He was asked what kind of problem he
 *      wants to solve and answered that the goal is to fix bad performance, to push
 *      speed and consumption to their limit, and that this is WHY he went further into
 *      Rust and GPUI. The first two beats are corroborated by the CV, not by me:
 *      "enhancing system processing speeds" under Technical Support Specialist, and
 *      "improving system response times" under Full Stack Developer. So the thread runs
 *      through both jobs and both personal projects on the record, and the causality is
 *      his: he picked the problem, and the stack followed from it.
 *
 *   2. The Reborn paragraph is his, near-verbatim in substance. He was asked for the
 *      hardest thing he had to resolve, and the answer was not a bug at all: the first
 *      version was too ambitious to solve anything and ended badly, so he rebuilt it
 *      from zero knowing his limits, and this time it did its job. The consequence is
 *      that the project's name is the lesson, which no CV line could carry.
 *
 * WHAT IS STILL MINE: the English, and the order. He answered in Spanish and this is a
 * translation, which preserves his claims and loses his cadence. If it does not sound
 * like him, it is because it is not yet his English.
 *
 * No new facts are introduced here. That is what makes prose safe to write on a page
 * whose argument is that its numbers are real.
 */
const intro = [
  'Performance is the problem I keep coming back to. In technical support it was making systems stop being slow. As a full-stack developer it was response times. Now I work in Rust and GPUI because that is where speed and resource consumption are actually decided.',
  'Sh_Images Reborn is named Reborn because the first version failed, and not because of a bug. It was too ambitious to solve anything, so I threw it away and rebuilt it from zero, this time knowing what I was able to finish. Both projects below come from that habit: the constraints are measurable, and the numbers come off the reports rather than out of a README.',
]

/* ------------------------------------------------------------------ *
 * The facts block. Every value below is measured, not typed.
 *
 * The rule for this block is that it must not be able to drift. A version number
 * written into a template is a lie the day somebody runs `pnpm upgrade` and forgets
 * this file, and a version number written by hand into a metadata line is the single
 * most forgettable string on a portfolio site. So every figure is read at build time
 * from the thing it describes, and a value that cannot be read is OMITTED — the line
 * it belonged on disappears rather than printing a plausible guess. A block that lies
 * about its own toolchain is worse than one that says less.
 * ------------------------------------------------------------------ */

/**
 * Astro's own version, from the RESOLVED package rather than from this repository's
 * `package.json` range. `astro: "^7.3.5"` is a range, and `7.9.0` satisfies it, so
 * printing the range would print a caret. `require` resolves through the exports map
 * and lands on the one version that was actually compiled, which is the number the
 * reader cares about. `astro/package.json` is an explicit subpath in Astro's exports,
 * so this is a supported entry point and not a reach into private internals.
 */
function resolvedVersion(specifier: string): string | undefined {
  try {
    return createRequire(import.meta.url)(specifier).version as string | undefined
  } catch {
    return undefined
  }
}

const astroVersion = resolvedVersion('astro/package.json')

/** Node and the platform, from the process doing the build. Cannot be wrong. */
const nodeVersion = process.versions.node
const platform = `${process.platform} ${process.arch}`

/**
 * The package manager that ran this build, from its own `user-agent` string.
 *
 * `pnpm` writes `pnpm/12.5.1 npm/? node/? win32 x64` into the environment for its own
 * child processes, so the manager is derived rather than assumed — which matters,
 * because a repository's lockfile name is a convention and the user agent is a fact
 * about the machine that produced the bytes. It is `undefined` when the build was not
 * run through a package manager, and then the segment is dropped, not faked.
 */
const packageManager = /^(?<name>[a-z]+)\/(?<version>\d[\w.+-]*)/.exec(
  process.env.npm_config_user_agent ?? '',
)?.groups

const toolchainLine = [
  astroVersion && `astro ${astroVersion}`,
  packageManager && `${packageManager.name} ${packageManager.version}`,
]
  .filter(Boolean)
  .join(' · ')

/**
 * `2 · active 2 · other 0`, computed from the same `getCollection` result the cards
 * below render, so the two cannot disagree.
 *
 * `other` is `total - active` and covers `maintenance` and `archived`, the other two
 * states in the schema. It is printed even at zero: a count of zero is information
 * (nothing is archived), and a segment that appears and disappears as projects land
 * makes the line harder to read across two visits than a fixed shape.
 *
 * NOT `shipped 1 · in progress 1`, which is what a summary block wants to say. `status`
 * is a lifecycle flag and it cannot tell a released project from an unreleased one:
 * Sh_Images Reborn is finished and shipped and is still `status: active`, because
 * `active` means maintained, not launched. A shipped/in-progress split would have to be
 * typed by hand per project, and a hand-typed count on a page whose whole argument is
 * that the numbers are real is the one thing this block must not do.
 */
const activeCount = projects.filter((project) => project.data.status === 'active').length

const projectsLine = `${projects.length} · active ${activeCount} · other ${projects.length - activeCount}`

/**
 * The technologies the site actually claims, derived from two existing sources rather
 * than typed: the curated `Native & systems` skill group, intersected with every
 * technology any shipped project actually uses.
 *
 * The intersection is the point. Either source alone is a claim that can go stale —
 * the skills taxonomy lists `Linux`, `Networking` and `Virtualization` for roles the
 * projects do not evidence, and the project stacks list `proptest`, which is a test
 * harness rather than a focus. What survives is what the owner has grouped as native
 * and systems work AND has actually built, so adding a Rust project cannot leave the
 * line claiming Rust is absent, and adding a Linux project cannot silently add a focus
 * that has not been written up.
 *
 * Both sides are already display-form (`skills.ts` holds `GPUI`, not `gpui`), so the
 * line reads the way the about page reads. If the group is ever renamed, the line goes
 * away instead of printing half of something.
 */
const stackUsed = new Set(projects.flatMap((project) => project.data.stack.map((s) => s.toLowerCase())))

const focusLine = (skillGroups.find((group) => group.label === 'Native & systems')?.items ?? [])
  .filter((item) => stackUsed.has(item.toLowerCase()))
  .join(' · ')

/**
 * The block as label/value pairs, each line dropped if its value could not be derived.
 * The separator is U+00B7 MIDDLE DOT, inside the declared unicode ranges, which the
 * arrow and the check mark this design used to reach for are not.
 *
 * `Built` is PROVENANCE, not a version number for the site: it is the toolchain that
 * compiled this page. `Toolchain` is the reproduction recipe — the same Astro version
 * named, next to the package manager. They look like a duplicate and are not: one says
 * what built the bytes, the other says what to install to build them again. If that
 * distinction is not worth the two lines, the Astro version on either one of them is
 * the thing to cut.
 */
const facts: { label: string; value: string }[] = [
  {
    label: 'Built',
    value: [astroVersion, nodeVersion && `Node ${nodeVersion}`, platform].filter(Boolean).join(' · '),
  },
  { label: 'Toolchain', value: toolchainLine },
  { label: 'Projects', value: projectsLine },
  { label: 'Focus', value: focusLine },
].filter((row) => row.value.length > 0)

/**
 * What the owner is doing right now, in one sentence.
 *
 * Both halves are already stated on this site rather than asserted here: Sh_Images
 * Reborn is a finished, released viewer that is `status: active` and still being
 * maintained, and Sh_Nexus says in its own words that it is in progress. The line is
 * written, not derived — `status: active` cannot tell a finished project from an
 * unfinished one, so there is nothing in the collection to compute this from.
 *
 * It is deliberately the quietest line in the intro: chrome size on the muted ramp, no
 * status light and no "available for work" badge, because whether the owner wants to
 * advertise availability is a decision he has not made yet. The intro is unframed, so
 * the surface here is `base`, where `subtext0` measures 7.37:1.
 */
const now =
  'maintaining a released desktop image viewer, and building a chat client and server alongside it.'
---

<BaseLayout title={`${site.name} — ${site.role}`} description={site.tagline}>
  <div class="page">
    <header class="intro">
      <div class="intro__text">
        <h1 class="intro__name">{site.name}</h1>
        <p class="intro__role">{site.role}</p>
        <p class="intro__tagline">{site.tagline}</p>
      </div>

      <img
        class="intro__portrait"
        src="/portrait.jpg"
        alt={site.name}
        width="360"
        height="450"
        loading="eager"
        fetchpriority="high"
      />
    </header>

    <div class="intro__body">
      {intro.map((paragraph) => (
        <p class="intro__para">{paragraph}</p>
      ))}
    </div>

    <p class="now">
      <span class="now__label">currently</span>
      <span class="now__sep" aria-hidden="true">│</span>
      <span class="now__text">{now}</span>
    </p>

    <section class="section" id="facts">
      <AsciiRule as="div" cols={88} />
      <h2 class="section__title">Facts</h2>

      <Panel surface="panel" class="facts">
        <dl class="facts__list">
          {
            facts.map((row) => (
              <Fragment>
                <dt class="label">{row.label}</dt>
                <dd class="facts__value">{row.value}</dd>
              </Fragment>
            ))
          }
        </dl>
      </Panel>
    </section>

    <section class="section" id="projects">
      <AsciiRule as="div" cols={88} />
      <h2 class="section__title">Projects</h2>

      {
        hasProjects ? (
          <ul class="cards" role="list">
            {projects.map((project) => (
              <li>
                <ProjectCard project={project} />
              </li>
            ))}
          </ul>
        ) : (
          <p class="cards__note">
            No projects yet. Create one markdown file in <code>src/content/projects/</code>.
          </p>
        )
      }
    </section>
  </div>
</BaseLayout>

<style>
  /* ---- The page ---------------------------------------------------------------
     A stack of three blocks with a real gap between them, sized in the chrome's own
     leading so the vertical rhythm belongs to the character grid rather than to a
     guessed pixel value. Each block is a grid, because a block's heading and its
     content are two rows of one thing rather than two elements that happen to be
     adjacent.

     EVERY SINGLE-COLUMN GRID HERE DECLARES ITS TRACK, and that is load-bearing rather
     than stylistic. A grid with no `grid-template-columns` has one implicit `auto`
     track, and an `auto` track is sized by its content — which is a trap on this site
     specifically, because `Panel` and `AsciiRule` both hold runs of 256 box-drawing
     characters that are clipped rather than counted. An `auto` track asks for the
     MAX-CONTENT size of that run, `fr` does not cap the answer, and the whole content
     column measured 2304px inside a 773px shell. `minmax(0, 1fr)` is the fix: the track
     is then resolved against the container's definite width, the long runs clip as they
     were always meant to, and the page stops opening sideways. Measured before and
     after, in a headless browser. */
  .page {
    --block-gap: calc(var(--leading-chrome) * 2em);

    display: grid;
    grid-template-columns: minmax(0, 1fr);
    row-gap: var(--block-gap);
  }

  .section {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
  }

  /* A bare rule, then the heading, then the content. The rule is the section break and
     the heading is the label, which is the same grammar `.prose h2` uses, so a section
     on this page and a section inside a case study read as one family. `cols` is 88,
     the shell's own cell count, so the rule is exactly as wide as the frame it divides
     and `min(88ch, 100%)` falls back to the container below that. It has to track
     `--shell-cols` in `BaseLayout.astro`; a smaller number is a rule that stops short
     of the frame. */
  .section :global(.rule) {
    margin-block-end: 0.7em;
  }

  /* 28px, uppercase and tracked. The size step is real; case, weight and tracking are
     what make it a heading on a greyscale display, which is why all four are here. */
  .section__title {
    font-size: var(--text-xl);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: var(--tracking-label);
    line-height: 1.25;
    margin-block-end: 1.2em;
  }

  /* ---- The intro -------------------------------------------------------------
     Unframed, because this is the reading part of the page and the frame belongs to the
     chrome. The name is the only 52px on the site: it is the one line that has to
     carry the page, and a second line at that size would stop it being the first.

     TWO COLUMNS ABOVE 51rem, ONE BELOW. The portrait is the second DOM child on
     purpose, so the name is what a screen reader and a crawler read first, and so a
     visitor who leaves on load never waited for the file. The stacked order is the
     same order: the text is what the page is for, and the photograph is context for it.

     `.intro__text` is a plain block and not a grid. Its track would be a single
     `auto`, and an `auto` track is content-sized — which is exactly the trap the rest
     of this file is written against. A block has a definite width from its grid area,
     so `min-width: 0` is the whole of what it needs.

     THE COLUMNS FIT AT 88 CELLS AND NOT ONE CELL MORE, which is why the photograph is
     capped below its own 360px. All the arithmetic below is in shell cells at
     `--text-base`, where 1ch is the font advance: 0.6em is 9.0px nominally and 8.781px
     measured in a browser, the same two figures already used by the Facts comment
     below and derived in typography.css.

       portrait   360px / 8.781px                       = 41.0 cells
                   360px IS 41 cells. That is the whole reason for that number and it is
                   also the problem: 41 of 88 is very nearly half the shell for one
                   element.
       name       13 characters at --text-hero (52px)
                   13 x 52 x 0.5854 = 395.7px              = 45.1 cells
       gutter     2ch                                     =  2.0 cells

       at 360px:  41.0 + 45.1 + 2.0 = 88.1 cells  -> OVER by 0.1 cell, under a pixel.
       At 360px the 52px name WRAPS, and it was measured wrapping: the text column
       resolves to 395.5px there against a name that needs 396.1px. A hair over on the
       last pixel of the widest line on the page is not a margin, it is the layout
       failing at the one size that cannot fail, so the cap is real rather than
       decorative.

       capped:    38.0 + 45.1 + 2.0 = 85.1 cells  -> 2.9 cells of slack, 25.8px.
       sharpness  38ch is 334px rendered from a 720px file, which is 2.16x. The 360px
                   figure was picked for 2x; the cap gives up 7% of the width and buys
                   back 25.8px of slack, so nothing about it costs sharpness.

     WHY THE PROSE IS NOT IN THE SECOND COLUMN. It was, and it measured 36 characters
     per line — about five words. That is the number the two-column layout can reach
     inside an 88-cell shell when the photograph wants half of it, and 36 is well below
     the 60-80 band typography.css documents. The 60-80 band is a CHARACTER count, not a
     pixel count, and it is not reachable by shrinking pixels: it is reachable only by
     giving the line more characters, which means taking them back from the image.

     So the split is by what the content is. The hero block is three short lines of
     identity, and three short lines are comfortable at 45 cells. The intro is three
     paragraphs of running prose, and running prose at 36 characters is not a margin
     question — it is a readability defect, and it was the exact content the owner asked
     to be able to read. The paragraphs now sit BELOW the hero at the full
     `--measure-prose`, which is 66 characters at 20px: 773px, the same width as the
     chrome column, by the arithmetic in typography.css.

     The photograph stays in the second column, because a portrait is content of a
     different shape: it needs presence, not measure, and it has none of the problems a
     45-character name has. */


     BREAKPOINT IS WHERE THE SHELL REACHES 88 CELLS. The shell is `min(88ch, 100% -
     2rem)`, so it is at full width once the viewport reaches 88ch + 2rem = 804.7px.
     51rem (816px) is the first whole rem above that; at 48rem the shell is 736px, which
     is 83.7 cells and cannot hold the two columns. Below the breakpoint the layout is
     one column and the photograph lands after the text. */
  .intro {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    row-gap: 2ch;
    align-items: start;
  }

  @media (min-width: 51rem) {
    .intro {
      grid-template-columns: minmax(0, 1fr) minmax(0, 38ch);
      column-gap: 2ch;
    }
  }

  .intro__text {
    min-width: 0;
  }

  /* The photograph, framed in the same language as everything else and by a completely
     different mechanism.

     NOT IN A `Panel`, and the reason is structural rather than stylistic. A panel's
     frame is real box-drawing TEXT sitting on a character grid: the top and bottom
     rails are runs of `─` and the sides are columns of `│`, both measured in `ch` and
     both depending on the font's 600/1000 advance and on `line-height: 1.5`. An image
     has no character grid. It has no advance, no line box, and no cell to sit in, so a
     photo inside a character frame either opens a gap in the rails or sits visibly off
     the ones it does not break — and nothing about the result names its own cause. So
     the three cues a panel gets are restated in the only language an `<img>` has:

       surface  `--surface-panel` (surface0), the rung every card and panel sits on.
                The intro itself is unframed on `base`, so surface0 is the next step
                up and the photograph lands on the page the way every other raised
                element does.
       border   `--c-frame`, 1px. This is the exact token the panel rails are drawn
                in, it resolves to overlay0, and overlay0 is documented as
                decorative-only — which is what a frame is. It is never a text colour
                here, and verify-structure.mjs checks that.
       radius   2px. `╭ ╮ ╰ ╯` each carry a 0.1 em arm on the 600 advance, and at the
                panel's 15px that arm is 1.5px, so 2px is the closest whole-pixel
                radius that echoes it. It is also the radius `:not(pre) > code` already
                uses, so this is the site's rounding and not a new one. 4px and up
                stops reading as a corner echo and starts reading as a rounded card,
                which is a different shape of thing.

     `width` and `height` on the element are the 360x450 box the browser reserves, and
     the aspect ratio it derives from them is what keeps the page from shifting. The
     CSS width below is the cap, not the size: `max-width: 38ch` is the arithmetic above,
     and `height: auto` lets the ratio do its work. No `object-fit` is needed and none
     is wanted — the file is already cropped 4:5 and the box is 4:5, so any fit rule
     here would be a crop the owner did not ask for. */
  .intro__portrait {
    width: 100%;
    max-width: 38ch;
    background-color: var(--surface-panel);
    border: 1px solid var(--c-frame);
    border-radius: 2px;
  }

  .intro__name {
    font-size: var(--text-hero);
    font-weight: 700;
    line-height: 1.1;
  }

  /* 24px and the accent, which is the same step a card title takes. The role is a
     label, not a headline, and letting it grow with the display scale would put two
     competing headlines at the top of the page. */
  .intro__role {
    font-size: var(--text-lg);
    color: var(--c-accent);
    line-height: 1.3;
  }

  /* The tagline, still the one line it has always been, as the subline under the role.
     Same size as the prose below it and told apart by colour and by a narrower measure
     — a size step here would make the tagline a third headline. */
  .intro__tagline {
    margin-block-start: 0.7em;
    font-size: var(--text-prose);
    line-height: var(--leading-prose);
    color: var(--c-text-soft);
    max-width: var(--measure-lede);
  }

  .intro__body {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    row-gap: 1.25em;
    margin-block-start: 1.6em;
  }

  .intro__para {
    font-size: var(--text-prose);
    line-height: var(--leading-prose);
    color: var(--c-text);
    max-width: var(--measure-prose);
  }

  /* Three tracks, not a sentence with a `│` in it. That is the whole trick behind the
     wrapped continuation: the text is its own grid item, so when it wraps at the
     measure, the second line starts under the FIRST CHARACTER of the text instead of
     under the label. A `│` between two inline spans would wrap to column zero.

     `--measure-prose` here is 66 characters OF THIS LINE'S OWN SIZE, not 66 characters
     of prose: `ch` resolves against the element, and this line is 14px, so the cap is
     541px rather than the 773px the 20px column gets. That is the right answer for a
     chrome line — a 14px sentence running the full width of a 773px column is 100
     characters and unreadable — and it is stated here because "66ch" reads like a
     promise about the prose measure and is not one on this element. */
  .now {
    display: grid;
    grid-template-columns: max-content max-content minmax(0, 1fr);
    align-items: baseline;
    margin-block-start: 1.4em;
    font-size: var(--text-sm);
    color: var(--c-text-muted);
    max-width: var(--measure-prose);
  }

  .now__label {
    text-transform: uppercase;
    letter-spacing: var(--tracking-label);
  }

  .now__sep {
    color: var(--c-frame);
    margin-inline: 0.5ch;
  }

  /* ---- Facts -----------------------------------------------------------------
     Framed, because it is a block of values rather than reading, and because the frame
     is what makes four short lines look like a panel instead of a stray list. */
  .facts :global(.panel__body) {
    padding-block: 1em;
    padding-inline: 1.5ch;
  }

  /* `dt` and `dd` as direct grid items rather than wrapped in a pair element, so one
     template aligns every label and every value down the block. A wrapper per pair
     would give each pair its own `max-content` track and the values would step in and
     out with their labels — the same reasoning the experience page uses for its own
     metadata. `max-content` for the label track is what makes the second column line up
     under `Built` without the label widths being hardcoded: the widest label sets the
     track, and a longer label would widen it rather than collide. */
  .facts__list {
    display: grid;
    grid-template-columns: max-content minmax(0, 1fr);
    gap: 0.25em 2ch;
    /* The same size as the value, so the block reads as four lines of a table rather
       than as a definition list with a caption. Labels are still quieter than values,
       and both clear AA on `surface0`: `subtext0` measures 5.65:1 there and the frame
       bounds the block to that surface. */
    font-size: var(--text-sm);
  }

  .facts__value {
    margin: 0;
    color: var(--c-text-soft);
  }

  /* ---- Projects --------------------------------------------------------------
     One column, full width: at 88 shell cells and 20px prose, two columns would give
     each summary about 31 characters, and 31 characters is not a sentence. The card
     explains the rest. `role="list"` is not decoration — `list-style: none` makes Safari
     drop list semantics entirely, and this list is the page's content. */
  .cards {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    row-gap: 2ch;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  /* For whoever runs the site, not for whoever reads it. */
  .cards__note {
    font-size: var(--text-sm);
    color: var(--c-text-muted);
  }
</style>
