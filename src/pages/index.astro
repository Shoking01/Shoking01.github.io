---
import { getCollection } from 'astro:content'

import BaseLayout from '../layouts/BaseLayout.astro'
import Panel from '../components/Panel.astro'
import AsciiRule from '../components/AsciiRule.astro'
import ProjectCard from '../components/ProjectCard.astro'
import { site } from '../site.config'

/**
 * Home. A TUI hero, then the project list straight out of the collection.
 *
 * There is no project data in this file. `getCollection` reads every markdown file in
 * `src/content/projects/`, so adding a project adds a card here without touching this
 * page — which is the whole point of the content layer.
 *
 * Sort order is `featured` first, then the author's `order`, then newest first. The
 * tiebreak matters: two projects with the same `order` should not swap places between
 * builds.
 */

const projects = (await getCollection('projects')).sort(
  (a, b) =>
    Number(b.data.featured) - Number(a.data.featured) ||
    a.data.order - b.data.order ||
    b.data.date.valueOf() - a.data.date.valueOf(),
)

const hasProjects = projects.length > 0

/**
 * What the owner is doing right now, in one sentence.
 *
 * Both halves are already stated on this site rather than asserted here: Sh_Images
 * Reborn is a finished, released viewer that is `status: active` and still being
 * maintained, and Sh_Nexus says in its own words that it is in progress. The line is
 * written, not derived — `status: active` cannot tell a finished project from an
 * unfinished one, so there is nothing in the collection to compute this from.
 *
 * It sits between the role and the tagline, not after the tagline, so the blinking caret
 * stays at the visual end of the hero. And it is deliberately the quietest line on the
 * page: no status light, no "available for work" badge, because whether the owner wants
 * to advertise availability is a decision he has not made yet.
 */
const now =
  'maintaining a released desktop image viewer, and building a chat client and server alongside it.'
---

<BaseLayout title={`${site.name} — ${site.role}`} description={site.tagline}>
  <Panel class="hero">
    <h1 class="hero__name">{site.name}</h1>
    <p class="hero__role">{site.role}</p>
    <p class="hero__now">
      <span class="hero__now-label">currently</span>
      <span class="hero__sep" aria-hidden="true">│</span>
      <span>{now}</span>
    </p>
    <p class="hero__tagline">
      {site.tagline}<span class="caret hero__caret" aria-hidden="true">█</span>
    </p>
  </Panel>

  <div id="projects">
    <AsciiRule label="projects" />
  </div>

  {
    hasProjects ? (
      <ul class="projects">
        {projects.map((project) => (
          <li class="projects__item">
            <ProjectCard project={project} />
          </li>
        ))}
      </ul>
    ) : (
      <Panel>
        <p class="projects__empty">
          No projects yet. Create one markdown file in <code>src/content/projects/</code>.
        </p>
      </Panel>
    )
  }
</BaseLayout>

<style>
  .hero {
    color: var(--c-text);
  }

  .hero__name {
    font-size: var(--text-2xl);
    font-weight: 700;
    line-height: 1.2;
  }

  .hero__role {
    color: var(--c-accent);
  }

  .hero__tagline {
    color: var(--c-text-soft);
    max-width: var(--measure-lede);
  }

  /* The quietest line in the hero, and deliberately so: a size step below the tagline,
     the muted ramp, and a `│` borrowed from the footer's separator grammar. The panel is
     `surface0`, which is the last surface `--c-text-muted` is documented as safe on
     (5.65:1), so this is the highest the line can go without giving up its subordination. */
  .hero__now {
    margin-block-start: 0.7em;
    font-size: var(--text-sm);
    color: var(--c-text-muted);
    max-width: var(--measure-lede);
  }

  .hero__now-label {
    text-transform: uppercase;
    letter-spacing: var(--tracking-label);
  }

  .hero__sep {
    color: var(--c-frame);
    margin-inline: 0.5ch;
  }

  /* Offset from the nav's caret so the two do not blink in lockstep. */
  .hero__caret {
    margin-inline-start: 0.5ch;
    animation-delay: 0.55s;
  }

  .projects {
    display: grid;
    gap: 1.5ch;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .projects__empty {
    color: var(--c-text-soft);
  }
</style>
