---
import { createRequire } from 'node:module'

import { getCollection } from 'astro:content'

import BaseLayout from '../layouts/BaseLayout.astro'
import SessionLine from '../components/SessionLine.astro'
import ProjectRow from '../components/ProjectRow.astro'
import { skillGroups } from '../data/skills'
import { site } from '../site.config'

/**
 * Home. One session, four commands, and no frame in the content column.
 *
 * A terminal's output changes shape — a prompt, a paragraph, a table, a blank line —
 * and that variety is the signal that it is a terminal and not a stack of cards. So
 * nothing here is a `Panel`. `Panel` still owns the chrome, the nav and the footer, and
 * it still owns a case study's metadata header; the scrollback below it is not framed.
 *
 *   adrián@portfolio:~$ cat profile
 *   adrián@portfolio:~$ uname -a
 *   adrián@portfolio:~$ ls -1 projects/
 *   adrián@portfolio:~$
 *
 * The order is the argument: who I am, what this machine is, what I have built. The
 * machine block sits in the middle because it is the transition — it is the point
 * where the page stops being a claim about a person and starts being evidence.
 *
 * There is no project data in this file. `getCollection` reads every markdown file in
 * `src/content/projects/`, so adding a project adds a row here without touching this
 * page — which is the whole point of the content layer, and now the reason the NAME
 * column reads like a file name: the row is the file.
 *
 * Sort order is `featured` first, then the author's `order`, then newest first. The
 * tiebreak matters: two projects with the same `order` should not swap places between
 * builds.
 */

const projects = (await getCollection('projects')).sort(
  (a, b) =>
    Number(b.data.featured) - Number(a.data.featured) ||
    a.data.order - b.data.order ||
    b.data.date.valueOf() - a.data.date.valueOf(),
)

const hasProjects = projects.length > 0

/** The count line a shell would print after a listing. Never an empty box. */
const count = `${projects.length} ${projects.length === 1 ? 'entry' : 'entries'}`

/* ------------------------------------------------------------------ *
 * uname -a. Every value below is measured, not typed.
 *
 * The rule for this block is that it must not be able to drift. A version number
 * written into a template is a lie the day somebody runs `pnpm upgrade` and forgets
 * this file, and a version number written by hand into a `uname` line is the single
 * most forgettable string on a portfolio site. So every figure is read at build time
 * from the thing it describes, and a value that cannot be read is OMITTED — the line
 * it belonged on disappears rather than printing a plausible guess. A `uname` that
 * lies about its own kernel is worse than one that says less.
 * ------------------------------------------------------------------ */

/**
 * Astro's own version, from the RESOLVED package rather than from this repository's
 * `package.json` range. `astro: "^7.3.5"` is a range, and `7.9.0` satisfies it, so
 * printing the range would print a caret. `require` resolves through the exports map
 * and lands on the one version that was actually compiled, which is the number the
 * reader cares about. `astro/package.json` is an explicit subpath in Astro's exports,
 * so this is a supported entry point and not a reach into private internals.
 */
function resolvedVersion(specifier: string): string | undefined {
  try {
    return createRequire(import.meta.url)(specifier).version as string | undefined
  } catch {
    return undefined
  }
}

const astroVersion = resolvedVersion('astro/package.json')

/** Node and the platform, from the process doing the build. Cannot be wrong. */
const nodeVersion = process.versions.node
const platform = `${process.platform} ${process.arch}`

/**
 * The package manager that ran this build, from its own `user-agent` string.
 *
 * `pnpm` writes `pnpm/12.5.1 npm/? node/? win32 x64` into the environment for its own
 * child processes, so the manager is derived rather than assumed — which matters,
 * because a repository's lockfile name is a convention and the user agent is a fact
 * about the machine that produced the bytes. It is `undefined` when the build was not
 * run through a package manager, and then the segment is dropped, not faked.
 */
const packageManager = /^(?<name>[a-z]+)\/(?<version>\d[\w.+-]*)/.exec(
  process.env.npm_config_user_agent ?? '',
)?.groups

const shellLine = [
  astroVersion && `astro ${astroVersion}`,
  packageManager && `${packageManager.name} ${packageManager.version}`,
]
  .filter(Boolean)
  .join(' · ')

/**
 * `Projects 2 · active 2 · other 0`, computed from the same `getCollection` result the
 * listing below renders, so the two cannot disagree.
 *
 * `other` is `total - active` and covers `maintenance` and `archived`, the other two
 * states in the schema. It is printed even at zero: a count of zero is information
 * (nothing is archived), and a segment that appears and disappears as projects land
 * makes the line harder to read across two visits than a fixed shape.
 *
 * NOT `shipped 1 · in progress 1`, which is what a `uname` block wants to say. `status`
 * is a lifecycle flag and it cannot tell a released project from an unreleased one:
 * Sh_Images Reborn is finished and shipped and is still `status: active`, because
 * `active` means maintained, not launched. A shipped/in-progress split would have to be
 * typed by hand per project, and a hand-typed count on a page whose whole argument is
 * that the numbers are real is the one thing this block must not do.
 */
const activeCount = projects.filter((project) => project.data.status === 'active').length

const projectsLine = `${projects.length} · active ${activeCount} · other ${projects.length - activeCount}`

/**
 * The technologies the site actually claims, derived from two existing sources rather
 * than typed: the curated `Native & systems` skill group, intersected with every
 * technology any shipped project actually uses.
 *
 * The intersection is the point. Either source alone is a claim that can go stale —
 * the skills taxonomy lists `Linux`, `Networking` and `Virtualization` for roles the
 * projects do not evidence, and the project stacks list `proptest`, which is a test
 * harness rather than a focus. What survives is what the owner has grouped as native
 * and systems work AND has actually built, so adding a Rust project cannot leave the
 * line claiming Rust is absent, and adding a Linux project cannot silently add a focus
 * that has not been written up.
 *
 * Both sides are already display-form (`skills.ts` holds `GPUI`, not `gpui`), so the
 * line reads the way the about page reads. If the group is ever renamed, the line goes
 * away instead of printing half of something.
 */
const stackUsed = new Set(projects.flatMap((project) => project.data.stack.map((s) => s.toLowerCase())))

const focusLine = (skillGroups.find((group) => group.label === 'Native & systems')?.items ?? [])
  .filter((item) => stackUsed.has(item.toLowerCase()))
  .join(' · ')

/**
 * The block as label/value pairs, each line dropped if its value could not be derived.
 * The separator is U+00B7 MIDDLE DOT, inside the declared unicode ranges, which the
 * arrow and the check mark this design used to reach for are not.
 *
 * On the first line, `Portfolio 7.3.5` is PROVENANCE, not a version number for the
 * site: it is the version of the toolchain that compiled this page, sitting where
 * `uname -a` puts a kernel version. The `Shell` line is the reproduction recipe — the
 * same Astro version named, next to the package manager. They look like a duplicate
 * and are not: one says what built the bytes, the other says what to install to build
 * them again. If that distinction is not worth the two lines, the Astro version on
 * either one of them is the thing to cut.
 */
const uname: { label: string; value: string }[] = [
  {
    label: 'Portfolio',
    value: [astroVersion, nodeVersion && `Node ${nodeVersion}`, platform].filter(Boolean).join(' · '),
  },
  { label: 'Shell', value: shellLine },
  { label: 'Projects', value: projectsLine },
  { label: 'Focus', value: focusLine },
].filter((row) => row.value.length > 0)

/**
 * What the owner is doing right now, in one sentence.
 *
 * Both halves are already stated on this site rather than asserted here: Sh_Images
 * Reborn is a finished, released viewer that is `status: active` and still being
 * maintained, and Sh_Nexus says in its own words that it is in progress. The line is
 * written, not derived — `status: active` cannot tell a finished project from an
 * unfinished one, so there is nothing in the collection to compute this from.
 *
 * It is deliberately the quietest line on the page: `--text-sm` on the muted ramp, no
 * status light, no "available for work" badge, because whether the owner wants to
 * advertise availability is a decision he has not made yet. Unframed, the page surface
 * is `base`, where `subtext0` measures 7.37:1 — a full point better than the panel it
 * used to sit in.
 */
const now =
  'maintaining a released desktop image viewer, and building a chat client and server alongside it.'
---

<BaseLayout title={`${site.name} — ${site.role}`} description={site.tagline}>
  <div class="session">
    <section class="session__step">
      <SessionLine command="cat profile" />

      <div class="profile">
        <h1 class="profile__name">{site.name}</h1>
        <p class="profile__role">{site.role}</p>

        <p class="profile__now">
          <span class="profile__now-label">currently</span>
          <span class="profile__now-sep" aria-hidden="true">│</span>
          <span class="profile__now-text">{now}</span>
        </p>

        <p class="profile__tagline">
          {site.tagline}<span class="caret profile__caret" aria-hidden="true">█</span>
        </p>
      </div>
    </section>

    <section class="session__step" id="system">
      <SessionLine as="h2" command="uname -a" />

      <dl class="uname">
        {
          uname.map((row) => (
            <>
              <dt class="uname__label">{row.label}</dt>
              <dd class="uname__value">{row.value}</dd>
            </>
          ))
        }
      </dl>
    </section>

    <section class="session__step" id="projects">
      <SessionLine as="h2" command="ls -1 projects/" />

      {
        hasProjects && (
          <table class="ls">
            <thead>
              <tr>
                <th scope="col" data-col="name">name</th>
                <th scope="col" data-col="status">status</th>
                <th scope="col" data-col="date">started</th>
                <th scope="col" data-col="stack">stack</th>
              </tr>
            </thead>
            <tbody>
              {projects.map((project) => (
                <ProjectRow project={project} />
              ))}
            </tbody>
          </table>
        )
      }

      <p class="ls__count">{hasProjects ? count : '(no entries)'}</p>

      {
        !hasProjects && (
          <p class="ls__note">
            No projects yet. Create one markdown file in <code>src/content/projects/</code>.
          </p>
        )
      }
    </section>

    <SessionLine />
  </div>
</BaseLayout>

<style>
  /* ---- The session -----------------------------------------------------------
     One blank line between steps, so a step is a block and the page reads as a
     transcript rather than as a list of sections. `--leading-chrome` is unitless, so
     this is exactly one line of leading at the body size. A step itself is flush: a
     command's output starts on the line under the command, as it does in a shell. */

  .session {
    --session-gap: calc(var(--leading-chrome) * 1em);

    display: grid;
    row-gap: var(--session-gap);
  }

  .session__step {
    display: grid;
  }

  /* ---- cat profile ----------------------------------------------------------- */

  .profile__name {
    font-size: var(--text-2xl);
    font-weight: 700;
    line-height: 1.2;
  }

  .profile__role {
    color: var(--c-accent);
  }

  .profile__tagline {
    margin-block-start: 0.7em;
    color: var(--c-text-soft);
    max-width: var(--measure-lede);
  }

  /* Three tracks, not a sentence with a `│` in it. That is the whole trick behind the
     wrapped continuation: the text is its own grid item, so when it wraps at the
     measure, the second line starts under the FIRST CHARACTER of the text instead of
     under the label. A `│` between two inline spans would wrap to column zero. */
  .profile__now {
    display: grid;
    grid-template-columns: max-content max-content minmax(0, 1fr);
    align-items: baseline;
    margin-block-start: 0.7em;
    font-size: var(--text-sm);
    color: var(--c-text-muted);
    max-width: var(--measure-lede);
  }

  .profile__now-label {
    text-transform: uppercase;
    letter-spacing: var(--tracking-label);
  }

  .profile__now-sep {
    color: var(--c-frame);
    margin-inline: 0.5ch;
  }

  /* Third phase, so the page has three caret rhythms rather than one. The animation
     itself, and the `prefers-reduced-motion` kill, are in global.css. */
  .profile__caret {
    margin-inline-start: 0.5ch;
    animation-delay: 0.55s;
  }

  /* ---- uname -a --------------------------------------------------------------- */

  /* `dt` and `dd` as direct grid items rather than wrapped in a pair div, so one
     template aligns every label and every value down the page. A wrapper per pair
     would give each pair its own `max-content` track and the values would step in and
     out with their labels — the same reasoning `about.astro` uses for `role__meta`.
     `max-content` for the label track is what makes the second column line up under
     `Portfolio` without the label widths being hardcoded: the widest label sets the
     track, and a longer label would widen it rather than collide. */
  .uname {
    display: grid;
    grid-template-columns: max-content minmax(0, 1fr);
    gap: 0.2em 2ch;
    /* The same size as the label and the value, so the block reads as four lines of
       output rather than as a definition list with a caption. The only reason the
       labels are still quieter than the values is `--c-text-muted`, which measures
       7.37:1 on `base` — the page is unframed, so that is the surface this sits on. */
    font-size: var(--text-sm);
  }

  .uname__label {
    color: var(--c-text-muted);
  }

  .uname__value {
    margin: 0;
    color: var(--c-text-soft);
  }

  /* ---- ls -1 projects/ ------------------------------------------------------- */

  /* `table-layout: auto`, not a fixed grid in `ch`: a real `ls` sizes each column to
     its widest cell, and a project called `sh-something-longer` has to widen the NAME
     column rather than collide with STATUS. The character grid is still the unit that
     matters — the gutters are `2ch` and the column-drop breakpoints below are sized
     against the shell's 76 cells — so the alignment is measured in characters even
     though the widths are content-driven.

     COLUMN DROP ORDER. Columns are dropped, not wrapped. A wrapped stack cell under
     a 16-character project name and a repository turns a listing into a paragraph, and
     the point of the table is that a value is always in the same place.

     There is now exactly one column that gives way:

       date  <= 710px   ten digits. A reader scanning a portfolio is looking for what a
                         project is, whether it is alive, and whether the code is worth
                         reading — not for the month it started.

     STACK is no longer droppable, and that is the decision this table is built around.
     The repository link used to be a SOURCE column that dropped at 380px, below most
     phones, which meant the one path from a listing to the code was the first thing to
     disappear. The repository now lives inside the STACK cell, and the cell that holds it
     is the one column that is never dropped — so the destination is in the tab order and
     on screen at every width, down to the narrowest phone this page has to work at.
     Folding the repository into a droppable cell would have changed nothing: both would
     have gone at the same breakpoint. NAME and STATUS are never dropped; they are the row.

     ARITHMETIC. `1ch` is exactly 9px at `--text-base` — 0.9375rem is 15px and JetBrains
     Mono's advance is 0.6em — so the shell's 76 cells are 684px. The shell is
     `min(684px, 100% - 2rem)`, so a content width W needs a viewport of W + 32px. The
     gutter is `2ch` = 18px per cell, minus the last child. A table will not shrink below
     its min-content width, so these are the numbers that decide where a column has to go.

     NAME and DATE are counted, not eyeballed, and they correct two figures this comment
     used to carry: `sh-images-reborn` is 16 characters, so NAME is 144px rather than the
     153px a 17-cell reading gave it, and `rust gpui axum proptest` is 23 characters, which
     is where the old 207px came from and is now confirmed. `2026-08-13` is 10 cells, so
     DATE is 90px. STATUS is the one carried measurement: `+ ACTIVE` is 62px. In a
     monospace face a cell count is not an estimate, so a count that disagrees with the
     old figure is a correction rather than a competing guess.

     STACK is re-measured rather than carried, because its content changed. The widest
     STACK cell is not the longest stack: it is the row that carries a repository. For
     Sh_Images Reborn that is `rust gpui windows` + the anchor's 1ch margin +
     `Sh_Images-Reborn` = 17 + 1 + 16 = 34 cells = 306px, and `ProjectRow` carries the
     label arithmetic. Sh_Nexus's `rust gpui axum proptest` is 23 cells = 207px and it has
     `links: []`, so it is not the widest cell and does not set the column.

       all four columns  name 144 + status 62 + date 90 + stack 306 + 3 gutters 54
                        = 656px, so the viewport must be >= 688px
       date dropped     name 144 + status 62 + stack 306 + 2 gutters 36
                        = 548px, so the viewport must be >= 580px

     The breakpoint is 710px: 688px of measured minimum plus 22px of slack, the same band
     and the same 22px the five-column table's first breakpoint used. Above 710px the shell
     is already capped at its 684px and the four-column row has 28px to spare inside it. At
     the breakpoint itself the widest row is the three-column 548px, 136px inside the same
     684px. It also cannot be lowered much: at 689px the shell is 657px and the four-column
     row wants 656, so one pixel is the entire margin. The breakpoint is pinned by the
     repository, not by the date.

     Re-derive both numbers if a project ships a longer repository name, and in particular
     when the TODO in `sh-nexus.md` is answered: a row with a 23-cell stack AND a repository
     is wider than any row this arithmetic has measured, and a breakpoint carried over from
     here would overflow the shell instead of dropping a column. */
  .ls {
    width: 100%;
    font-size: var(--text-base);
  }

  .ls :global(th),
  .ls :global(td) {
    padding-block: 0.35em;
    /* The gutter, in cells. */
    padding-inline-end: 2ch;
    text-align: start;
    white-space: nowrap;
  }

  .ls :global(th:last-child),
  .ls :global(td:last-child) {
    padding-inline-end: 0;
  }

  .ls thead th {
    font-size: var(--text-micro);
    font-weight: 400;
    text-transform: uppercase;
    letter-spacing: var(--tracking-label);
    color: var(--c-text-muted);
    /* A rule that carries meaning: it separates the column names from the data, which
       is the one `--c-line-strong` use on this page. Row rules below are division
       only, so they take the subtle token. */
    border-block-end: 1px solid var(--c-line-strong);
  }

  .ls tbody :global(th),
  .ls tbody :global(td) {
    border-block-end: 1px solid var(--c-line-subtle);
  }

  .ls tbody :global(tr:last-child th),
  .ls tbody :global(tr:last-child td) {
    border-block-end: 0;
  }

  /* A raised surface, not a colour change: the row is on `base` and this lifts it to
     `surface0`, which is the elevation ramp doing what it is for. Every colour in the
     row clears AA there — `subtext0` measures 5.65:1 and the accents are documented as
     safe to `surface1`. */
  .ls tbody :global(tr:hover) {
    background-color: var(--surface-panel);
  }

  /* See the note above for the order and the arithmetic. It is `display: none` rather
     than a smaller font or a collapsed width for the reason a hidden link must leave
     the tab order too: a cell that is dropped is gone, and an anchor that is still
     focusable inside a `visibility: hidden` or `opacity: 0` cell is a focus stop on
     something nobody can see. DATE is the only cell that drops, and it holds no link —
     the repository lives in STACK, which never drops, so at every width the row has
     exactly the links it shows. */
  @media (max-width: 710px) {
    .ls :global([data-col='date']) {
      display: none;
    }
  }

  .ls__count {
    font-size: var(--text-sm);
    color: var(--c-text-muted);
  }

  /* For whoever runs the site, not for whoever reads it. */
  .ls__note {
    font-size: var(--text-sm);
    color: var(--c-text-muted);
  }
</style>
