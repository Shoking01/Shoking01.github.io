---
import BaseLayout from '../layouts/BaseLayout.astro'
import Panel from '../components/Panel.astro'
import AsciiRule from '../components/AsciiRule.astro'
import { site } from '../site.config'
---

<BaseLayout title={`${site.name} — ${site.role}`} description={site.tagline}>
  <Panel>
    <h1 class="hero__name">{site.name}</h1>
    <p class="hero__role">{site.role}</p>
  </Panel>

  <AsciiRule label="about" />

  <Panel>
    <p>{site.tagline}</p>
  </Panel>
</BaseLayout>

<style>
  .hero__name {
    font-size: var(--text-2xl);
    font-weight: 700;
    line-height: 1.2;
    color: var(--c-text);
  }

  .hero__role {
    color: var(--c-text-soft);
  }
</style>
