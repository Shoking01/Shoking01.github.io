---
import { getCollection } from 'astro:content'

import BaseLayout from '../layouts/BaseLayout.astro'
import AsciiRule from '../components/AsciiRule.astro'
import { skillGroups } from '../data/skills'
import { site } from '../site.config'

/**
 * About. Experience and Skills, on ONE route, on purpose.
 *
 * The two sections were weighed as two pages and the split lost. Two pages holding two
 * and five items each is worse information architecture than one dense page, because
 * the reader who wants both has to choose an order to get them, and the order they want
 * is the order the page would have. The shell also benefits from fewer, denser routes:
 * every extra route is another frame, another title, another canonical, another sitemap
 * entry, and another thing to keep in the nav. If the owner later wants them apart it is
 * a small change: move the two sections into two pages and this file becomes the
 * experience half.
 *
 * It is the same grammar as the home page — a rule, a section heading, the content —
 * with different content. What was removed is the same thing that was removed there:
 * the `cat experience` and `cat skills` commands and the `*` that stood in for the
 * shape of a list item. A job is not command output. Each one is a block: what the
 * role was, where it was, when it ran, and then the work, at prose size, as sentences a
 * reader can read rather than as fragments they have to reassemble.
 *
 * NO VISIBLE `h1`, and that is a decision rather than an omission. The page has two
 * section headings and both are real `h2`s, so the outline is correct and a screen
 * reader announces the sections; what it does not have is a large word at the top whose
 * only content is the word "About", which is what the home page's 52px name is for and
 * what repeating here would dilute. The hidden heading keeps the document named.
 */

const roles = (await getCollection('experience')).sort(
  (a, b) =>
    b.data.start.valueOf() - a.data.start.valueOf() ||
    // An ongoing role has no `end`, and sorts as the latest possible end: a role that is
    // still open is more recent than one that closed in the month it started.
    (b.data.end?.valueOf() ?? Number.POSITIVE_INFINITY) -
      (a.data.end?.valueOf() ?? Number.POSITIVE_INFINITY) ||
    // Two roles can share a start month, and the order still has to be the same on every
    // build. Employer name is arbitrary but stable, which is all a tiebreak has to be.
    a.data.company.localeCompare(b.data.company),
)

const hasRoles = roles.length > 0

/** What a listing prints after it. Never an empty section. */
const roleCount = `${roles.length} ${roles.length === 1 ? 'role' : 'roles'}`

const skillCount = skillGroups.reduce((total, group) => total + group.items.length, 0)

const MONTHS = [
  'Jan',
  'Feb',
  'Mar',
  'Apr',
  'May',
  'Jun',
  'Jul',
  'Aug',
  'Sep',
  'Oct',
  'Nov',
  'Dec',
]

/**
 * A role's start or end, at the precision the source stated.
 *
 * `granularity` is not decoration: `z.coerce.date()` turns `2025` and `2025-01-01` into
 * the same value, so without it a role the CV dated by year would render a January
 * nobody ever claimed. Read the month in UTC because the coerced date is UTC midnight,
 * and a local `getMonth()` would show the previous month west of Greenwich.
 */
function stamp(date: Date, granularity: 'month' | 'year'): string {
  const year = date.getUTCFullYear()
  return granularity === 'year' ? `${year}` : `${MONTHS[date.getUTCMonth()]} ${year}`
}

/** `2025-10` coerced, for the `datetime` attribute. Day precision is a claim too. */
function iso(date: Date): string {
  return date.toISOString().slice(0, 10)
}

/**
 * Spoken languages. Prose rather than a data entry, because it is a claim about a person
 * rather than a capability that can be listed, and the CEFR level is more precise than a
 * group heading could carry.
 */
const languages = 'Spanish native, English professional working proficiency (B2+).'
---

<BaseLayout
  title={`About — ${site.name}`}
  description="Roles, what was done in them, and the stack: a full-stack developer who started in technical support and root cause analysis."
>
  <div class="page">
    <h1 class="visually-hidden">About</h1>

    <div class="body">
      <div class="body__main">
        <section class="section" id="experience">
          <AsciiRule as="div" />
          <h2 class="section__title">Experience</h2>

          {
            hasRoles ? (
              <ol class="roles" role="list">
                {roles.map((entry) => {
                  const { company, role, location, remote, start, end, current, granularity, summary, highlights, stack } =
                    entry.data
                  // Unreachable while the schema holds, and the same wording the schema forbids,
                  // rather than `undefined` rendered into a page.
                  const open = current || !end
                  return (
                    <li class="role">
                      <h3 class="role__title">{role}</h3>

                      <p class="role__company">
                        {company}
                        {remote && <span class="role__remote">remote</span>}
                      </p>

                      <dl class="role__meta">
                        <dt class="label">period</dt>
                        <dd>
                          <time datetime={iso(start)}>{stamp(start, granularity)}</time>
                          <span class="role__sep">-</span>
                          {open ? (
                            <span>present</span>
                          ) : (
                            <time datetime={iso(end!)}>{stamp(end!, granularity)}</time>
                          )}
                        </dd>

                        <dt class="label">location</dt>
                        <dd>{location}</dd>
                      </dl>

                      {summary && <p class="role__summary">{summary}</p>}

                      <ul class="role__highlights" role="list">
                        {highlights.map((highlight) => (
                          <li class="role__highlight">
                            <span class="role__bullet" aria-hidden="true">*</span>
                            <span class="role__highlight-text">{highlight}</span>
                          </li>
                        ))}
                      </ul>

                      {stack.length > 0 && (
                        <ul class="role__stack" role="list">
                          {stack.map((item) => (
                            <li class="role__tech">{item}</li>
                          ))}
                        </ul>
                      )}
                    </li>
                  )
                })}
              </ol>
            ) : (
              <p class="count">(no entries)</p>
            )
          }

          {
            hasRoles && (
              <p class="count">{roleCount}</p>
            )
          }

          {
            !hasRoles && (
              <p class="count__note">
                No roles yet. Create one markdown file in <code>src/content/experience/</code>.
              </p>
            )
          }
        </section>
      </div>

      <aside class="body__rail">
        <section class="section" id="skills">
          <AsciiRule as="div" />
          <h2 class="section__title">Skills</h2>

          <p class="languages">
            <span class="languages__label">spoken</span>
            <span class="languages__sep" aria-hidden="true">│</span>
            <span class="languages__text">{languages}</span>
          </p>

          <div class="groups">
            {
              skillGroups.map((group) => (
                <section class="group">
                  <h3 class="label">{group.label}</h3>
                  <ul class="group__items" role="list">
                    {group.items.map((item) => (
                      <li class="group__item">{item}</li>
                    ))}
                  </ul>
                </section>
              ))
            }
          </div>

          <p class="count">{skillCount} items in {skillGroups.length} groups</p>
        </section>
      </aside>
    </div>
  </div>
</BaseLayout>

<style>
  /* ---- The page ---------------------------------------------------------------
     The same two-block grammar as the home page, so the two pages read as one site:
     a real gap between blocks, sized in the chrome's own leading, and each block a
     grid of heading and content rather than a stack of adjacent elements.

     Every single-column grid declares its track, and on this page that is load-bearing
     rather than stylistic. An implicit `auto` track is sized by its content, and
     `AsciiRule` holds a run of 256 box-drawing characters that is meant to be clipped
     rather than counted — so the track asks for the run's max-content size, `fr` does
     not cap the answer, and the content column measures 2304px inside a 773px shell.
     `minmax(0, 1fr)` resolves the track against the container's definite width instead,
     and the long runs clip as they were always meant to. */
  .page {
    --block-gap: calc(var(--leading-chrome) * 2em);

    display: grid;
    grid-template-columns: minmax(0, 1fr);
    row-gap: var(--block-gap);
  }

  .section {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
  }

  /* A bare rule, then the heading. The rule is the section break and the heading is the
     label, which is the grammar `.prose h2` uses inside a case study, so a section here
     and a section in a case study are one family. `cols` is 88, the shell's own cell
     count, so the rule is exactly as wide as the frame it divides; it has to track
     `--shell-cols` in `BaseLayout.astro`. */
  .section :global(.rule) {
    margin-block-end: 0.7em;
  }

  .section__title {
    font-size: var(--text-xl);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: var(--tracking-label);
    line-height: 1.25;
    margin-block-end: 1.4em;
  }

  /* ---- The two-column split ---------------------------------------------------
     THE SAME GRID AS THE HOME PAGE, and it is here for the same reason: the shell is
     130 cells and the reading measure is 88 of them, so a page that used all 130 for
     one column of prose would leave 369px of dead space beside every paragraph. The
     full derivation, the rejected 94-cell alternative and the breakpoint arithmetic are
     in `index.astro` under "The page grid"; the three numbers are `--content-cols`
     (88), `--rail-cols` (40) and `--gutter-cols` (2), and they live in `BaseLayout`
     because the measure they have to agree with lives in `typography.css`.

     WHAT GOES WHERE IS NOT ARBITRARY. Experience is the argument — two roles, six
     bullets, read top to bottom in sentences — so it keeps the 66ch reading column and
     the full width it had before. Skills is a lookup table: 26 items in four groups,
     and nobody reads it as a document. It is the thing that was losing to a full-width
     band, and in a rail it becomes what it always was, a reference.

     The content track is a LENGTH (`--content-cols` in `ch`), not `1fr`, and the rail
     takes the remainder. The shell is capped at 130 cells, so that remainder is exactly
     40 cells and the rail can never grow — which is the point: the reading column is
     pinned to the measure by construction, not by a subtraction staying correct. */
  @media (min-width: 74rem) {
    .body {
      display: grid;
      grid-template-columns: minmax(0, calc(var(--content-cols) * 1ch)) minmax(0, 1fr);
      column-gap: calc(var(--gutter-cols) * 1ch);
      align-items: start;
    }

    .body__rail {
      position: sticky;
      top: var(--sticky-top);
    }
  }

  /* ---- Experience ------------------------------------------------------------
     Unframed. The project cards on the home page are framed because each one is a
     self-contained item to be compared; a CV is not a set of items to be compared, it
     is a document read top to bottom, so a rule between roles and no frame is the
     honest treatment. A stack of identical panels around two jobs would look like
     content the page is padding itself with. */
  .roles {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    row-gap: 2.4em;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  /* The rule that separates one role from the next, `--c-line-subtle` because it
     divides and does not carry meaning. A role that has no predecessor has nothing to be
     separated from, so the first one does not draw one. */
  .role + .role {
    border-block-start: 1px solid var(--c-line-subtle);
    padding-block-start: 2.4em;
  }

  /* 24px, the same step a project card title takes: a job title is the name of a
     subject, and a subject is read once and named once. */
  .role__title {
    font-size: var(--text-lg);
    font-weight: 700;
    line-height: 1.3;
  }

  /* The employer under the role, at prose size in the accent, so the two-line subject
     block is title then organisation rather than two competing lines. */
  .role__company {
    font-size: var(--text-prose);
    line-height: var(--leading-prose);
    color: var(--c-accent);
  }

  /* "remote" is a fact about the job and a hue is not a fact, so it is a word. It is
     not a `StatusTag`: that component's contract is a lifecycle state with a colour per
     state, and "remote" is neither — adding it there would mean inventing a fourth
     state or leaving a component with a colourless branch. Rendered in the same tracked
     micro caps the `label` utility uses, and only when the schema says it is true. */
  .role__remote {
    margin-inline-start: 1.5ch;
    font-size: var(--text-micro);
    text-transform: uppercase;
    letter-spacing: var(--tracking-label);
    color: var(--c-text-muted);
    white-space: nowrap;
  }

  /* `dt` and `dd` are direct grid items rather than wrapped in a pair element, so one
     template aligns every label and every value in the column down the page. A wrapper
     per pair would give each pair its own `max-content` track and the values would step
     in and out with their labels. */
  .role__meta {
    display: grid;
    grid-template-columns: max-content minmax(0, 1fr);
    gap: 0.2em 2ch;
    margin-block-start: 0.8em;
  }

  .role__meta dd {
    margin: 0;
    font-size: var(--text-sm);
    color: var(--c-text-soft);
  }

  /* Not `aria-hidden`: a screen reader should still hear a range as a range. ASCII `-`
     rather than an en dash, and `-` rather than the arrow glyph, which is outside both
     declared font faces. */
  .role__sep {
    color: var(--c-text-muted);
    padding-inline: 0.35ch;
  }

  /* Optional, because a CV states what was done rather than what the job was, and there
     is no honest one-liner to write for a role whose only source is its bullets. The
     schema says so; this is where the schema's decision shows up. */
  .role__summary {
    margin-block-start: 0.9em;
    font-size: var(--text-prose);
    line-height: var(--leading-prose);
    color: var(--c-text);
    max-width: var(--measure-prose);
  }

  /* THE BULLETS ARE PROSE NOW. A highlight is a sentence a person wrote about work
     they did, and at 20px it is three or four lines of a column rather than a fragment
     on one line, so this is the page's reading mode and not a list of chrome.

     The font size is declared HERE, on the element that carries the measure, and not on
     the items. `ch` resolves against the element's OWN font size, so a `66ch` max-width
     on a list that is still inheriting the 15px chrome size is 580px — and 580px of 20px
     text is 48 characters, not the 66 the measure means. Declaring the size one level up
     makes the measure and the text it measures the same declaration, so the two cannot
     drift apart, and the items below inherit it.

     Two columns, marker then text, for the same reason the `currently` line on the home
     page has three: a wrapped line has to start under the FIRST CHARACTER of the text,
     not under the marker. An inline `*` inside a paragraph would put the second line
     back at column zero and the list would stop being a list.

     The leading is 1.6 rather than the prose 1.75 because these are separate
     one-sentence items with a margin between them, not consecutive paragraphs of one
     account. Paragraphs need the air; a list of statements does not, and at 1.75 the
     gaps are indistinguishable from accidental. */
  .role__highlights {
    max-width: var(--measure-prose);
    margin-block-start: 1em;
    padding-inline-start: 2ch;
    list-style: none;
    font-size: var(--text-prose);
  }

  .role__highlight {
    display: grid;
    grid-template-columns: max-content minmax(0, 1fr);
    gap: 0 0.5ch;
    line-height: 1.6;
  }

  .role__highlight + .role__highlight {
    margin-block-start: 0.5em;
  }

  /* The marker is decorative: a `*` before a sentence is a shape, and a screen reader
     announcing "star" before every highlight would be noise. It is a separate span
     rather than a `::before` because a generated box is not selectable, not copyable and
     not reachable by a text zoom that re-flows the grid. */
  .role__bullet {
    color: var(--c-accent);
  }

  .role__stack {
    display: flex;
    flex-wrap: wrap;
    gap: 0.2em 1.5ch;
    margin-block-start: 1.2em;
    padding: 0;
    list-style: none;
    font-size: var(--text-sm);
    color: var(--c-text-muted);
  }

  .role__tech::before {
    content: '#';
    color: var(--c-line);
  }

  /* ---- Skills ----------------------------------------------------------------
     Four groups, uneven on purpose, and the unevenness is the grouping. `src/data/
     skills.ts` explains the two placements that look like mistakes — Rust under both
     Languages and Native & systems, Node.js and Tailwind under Web — and the
     certifications that are deliberately absent. Do not "fix" that file from here. */
  .languages {
    display: grid;
    /* Three tracks, so a wrapped sentence resumes under the first character of the
       text and not under the label. The same grammar as the `currently` line. */
    grid-template-columns: max-content max-content minmax(0, 1fr);
    align-items: baseline;
    gap: 0 0.5ch;
    font-size: var(--text-prose);
    line-height: var(--leading-prose);
    color: var(--c-text);
    max-width: var(--measure-prose);
  }

  .languages__label {
    font-size: var(--text-micro);
    text-transform: uppercase;
    letter-spacing: var(--tracking-label);
    color: var(--c-text-muted);
  }

  .languages__sep {
    color: var(--c-frame);
  }

  /* `auto-fit` with a `ch` floor rather than a fixed column count: two columns at the
     shell's 88 cells, one below that, and never a column narrower than the longest item
     needs to stay on one line. The floor is the chrome's `ch` at 15px, which is the
     grid the `#` markers are counted in. */
  .groups {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(30ch, 1fr));
    gap: 1.6ch 3ch;
    margin-block-start: 1.4em;
    margin-block-end: 0;
    min-width: 0;
  }

  /* The group headings carry the `.label` utility rather than a local copy of it: this
     page is unframed, so the surface is `base`, where `subtext0` measures 7.37:1 and
     the utility is safe. It gives the same uppercase-and-tracked treatment the section
     titles use, one step down. */
  .group__items {
    display: flex;
    flex-wrap: wrap;
    gap: 0.3em 1.5ch;
    margin-block-start: 0.7em;
    margin-block-end: 0;
    padding: 0;
    list-style: none;
    font-size: var(--text-sm);
    color: var(--c-text);
  }

  /* The same `#` prefix the project cards and the role stacks use for a tool, so a
     wrapped row of skills cannot be misread as a run of prose. It is inline, next to its
     own word, so it is not announced as a list marker and needs no `aria-hidden` span of
     its own — unlike the `*` above, which starts a line. */
  .group__item::before {
    content: '#';
    color: var(--c-line);
    margin-inline-end: 0.35ch;
  }

  /* ---- Counts ----------------------------------------------------------------
     What a listing prints after itself. An empty collection says `(no entries)` rather
     than leaving a gap where a count would go, so the page never has a hole in it. */
  .count {
    margin-block-start: 1.4em;
    font-size: var(--text-sm);
    color: var(--c-text-muted);
  }

  /* For whoever runs the site, not for whoever reads it. */
  .count__note {
    font-size: var(--text-sm);
    color: var(--c-text-muted);
  }
</style>
