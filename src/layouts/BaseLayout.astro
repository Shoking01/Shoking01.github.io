---
import { ClientRouter } from 'astro:transitions'

import { paletteCss } from '../styles/palette'
import '../styles/fonts.css'
import '../styles/tokens.css'
import '../styles/typography.css'
import '../styles/global.css'

import SiteNav from '../components/SiteNav.astro'
import SiteFooter from '../components/SiteFooter.astro'
import Seo from '../components/Seo.astro'
import { site } from '../site.config'

/**
 * The shell. Nav, main, footer, skip link, and the one script the site ships.
 *
 * `ClientRouter` is the only client-side JavaScript here. It is not an island and it
 * is not a framework: it is Astro's view-transition router, and it is the reason
 * navigating between the home page and a project does a cross-fade instead of a full
 * page load. Everything else on this site is static HTML and CSS.
 *
 * The palette is generated here rather than in a stylesheet because it comes from a
 * Node import. Custom properties resolve at computed-value time, so `tokens.css` can
 * alias `--ctp-*` regardless of the order these two end up in.
 */

interface Props {
  title: string
  description: string
  /** Open Graph object type. */
  type?: 'website' | 'article'
  /** ISO date, for `article:published_time`. */
  publishedTime?: string
}

const { title, description, type, publishedTime } = Astro.props

const palette = paletteCss()
---

<!doctype html>
<html lang={site.locale}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />

    <Seo title={title} description={description} type={type} publishedTime={publishedTime} />

    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <link rel="sitemap" href="/sitemap-index.xml" />

    <ClientRouter />

    <style is:global set:html={palette} />
  </head>

  <body>
    <a class="skip-link" href="#main">Skip to content</a>

    <div class="shell">
      <SiteNav />

      <main id="main" class="shell__main" tabindex="-1">
        <slot />
      </main>

      <SiteFooter />
    </div>
  </body>
</html>

<style>
  /* One width for the whole shell, measured in character cells, so the nav, the main
     column and the footer all start and end on the same column of the grid. This is the
     same `ch` unit `Panel` measures its frame in.

     76 -> 88, and the whole reason is the prose. `ch` scales with the font size, so
     the 66-character reading column went from 673px at 17px to 792px at 20px, and a
     684px shell no longer held it. 88 cells at 15px is 792px, which is exactly
     66 cells at 20px — 88 x 15 = 66 x 20 — so the reading column and the chrome are
     the same physical width and neither one has slack the other does not. The full
     derivation, and the measure-drop alternative that was rejected, are in
     `typography.css` under `--measure-prose`.

     `wide` is gone with this. A case study used to ask for a second, wider shell
     (88 cells) so the reading column had room; that number is now the default, so
     the prop had nothing left to switch and the case study renders identically
     before and after. */
  .shell {
    --shell-cols: 88;
    display: flex;
    flex-direction: column;
    gap: 2ch;
    width: min(calc(var(--shell-cols) * 1ch), 100% - 2rem);
    margin-inline: auto;
    min-height: 100svh;
    padding-block: 1.5ch 2ch;
  }

  .shell__main {
    flex: 1 0 auto;
    min-width: 0;
    padding-block: 1ch;
  }

  .shell__main:focus {
    outline: none;
  }
</style>
