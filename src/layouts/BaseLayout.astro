---
import { createHash } from 'node:crypto'
import { execFileSync } from 'node:child_process'
import { readFileSync } from 'node:fs'
import { join } from 'node:path'

import { ClientRouter } from 'astro:transitions'

import { paletteCss } from '../styles/palette'
import '../styles/fonts.css'
import '../styles/tokens.css'
import '../styles/typography.css'
import '../styles/global.css'

import SiteNav from '../components/SiteNav.astro'
import SiteFooter from '../components/SiteFooter.astro'
import Seo from '../components/Seo.astro'
import { site } from '../site.config'

/**
 * Where `public/` is.
 *
 * `process.cwd()`, not `import.meta.url`. Astro compiles a component's frontmatter into
 * a Vite module, so `import.meta.url` there is the URL of the BUNDLE rather than of this
 * `.astro` file, and `../..` walked up from it resolves somewhere that has no `public/`
 * in it. The symptom was silent and looked like a hash bug: `readFileSync` threw, the
 * `catch` returned an empty string, and the page shipped `href="/favicon-.svg"` — a
 * link to nothing that still passed every other check.
 *
 * Astro sets the cwd to the project root for the whole build, and this is a file read
 * during the build, so that is the one location guaranteed to be right.
 */
const publicDir = join(process.cwd(), 'public')

/**
 * The bytes of a public file as the REPOSITORY holds them, not as the working copy does.
 *
 * Both halves of the fingerprint have to read the same bytes or the name is wrong, and
 * "the working copy" is not a single answer. `.gitattributes` forces LF in the repository
 * and on CI's checkout, while a Windows worktree with `core.autocrlf=true` holds the file
 * with CRLF. Reading the working copy here produced `55589999` on Windows and `ac8ed44f`
 * on Linux, while `scripts/favicon.mjs` had written the copy under the other one — and the
 * deploy failed on `every declared icon resolves to a file that ships`, the check written
 * to catch precisely this.
 *
 * `git show HEAD:<path>` returns the committed blob, which is what CI checks out, so both
 * the generator and this layout compute the same name on every machine. Falls back to the
 * working copy for a file nothing has committed yet, which is the only case where they can
 * still disagree, and in that case there is nothing to disagree with.
 */
function committedBytes(file: string): Buffer | null {
  try {
    return execFileSync('git', ['show', `HEAD:public/${file}`], {
      cwd: process.cwd(),
      maxBuffer: 8 * 1024 * 1024,
      stdio: ['ignore', 'pipe', 'ignore'],
    })
  } catch {
    return null
  }
}

/**
 * The shell. Nav, main, footer, skip link, and the one script the site ships.
 *
 * `ClientRouter` is the only client-side JavaScript here. It is not an island and it
 * is not a framework: it is Astro's view-transition router, and it is the reason
 * navigating between the home page and a project does a cross-fade instead of a full
 * page load. Everything else on this site is static HTML and CSS.
 *
 * The palette is generated here rather than in a stylesheet because it comes from a
 * Node import. Custom properties resolve at computed-value time, so `tokens.css` can
 * alias `--ctp-*` regardless of the order these two end up in.
 */

interface Props {
  title: string
  description: string
  /** Open Graph object type. */
  type?: 'website' | 'article'
  /** ISO date, for `article:published_time`. */
  publishedTime?: string
}

const { title, description, type, publishedTime } = Astro.props

const palette = paletteCss()

/**
 * A content fingerprint for the icon, used to name the file rather than to query it.
 *
 * THE BUG THIS FIXES. The icon was `/favicon.svg` on a bare path. A URL that never
 * changes is a file the browser never asks for again: the first response is cached and
 * nothing in the page can ever make the browser suspect the file had changed underneath
 * it. GitHub Pages adds `Cache-Control: max-age=600` on top, so the observable symptom
 * was a tab still showing the previous site's icon long after a deploy that had replaced
 * every byte of it — with nothing wrong on the server to find, because the server was
 * serving the correct file and the browser was simply never asking.
 *
 * THAT IS WHY "just clear your cache" IS NOT A FIX. It resolves the symptom for the one
 * person who clears their cache and leaves the mechanism intact for the next person and
 * for every visitor whose tab was already open.
 *
 * WHY THE STAMP IS IN THE FILENAME AND NOT A QUERY STRING. The first attempt appended
 * `?v=<hash>`, and the built HTML came out with the query stripped: Vite treats an
 * absolute reference into `public/` as an asset path and rewrites it to the clean one,
 * so the stamp never reached the browser at all. `dist/index.html` was verified to carry
 * bare paths and the hash was absent. A query string cannot survive here; a path segment
 * can, and it is the same thing hashed build output does.
 *
 * `sha256` truncated to 8 hex characters: 32 bits is far more than is needed to mean
 * "this file has not changed", and it keeps the name debuggable. Read from the real file
 * at build time, so it cannot drift from what is shipped. A missing file yields an empty
 * stamp and `verify-structure.mjs` check 9 fails on the missing file rather than
 * shipping a link to nothing.
 */
function fingerprint(file: string): string {
  const path = join(publicDir, file)
  let bytes: Buffer
  try {
    bytes = committedBytes(file) ?? readFileSync(path)
  } catch (cause) {
    // A silent empty string here shipped `/favicon-.svg`, a link to nothing that passed
    // every other check in the build. An icon that cannot be hashed is a broken build,
    // not a cosmetic one, so it throws with the path it tried.
    throw new Error(
      `favicon: cannot read ${path} to fingerprint it. The icon links in this layout ` +
        `point at a name derived from this hash, so an empty one is a 404 in the tab. ` +
        `Original error: ${cause}`,
    )
  }
  return createHash('sha256').update(bytes).digest('hex').slice(0, 8)
}

const iconSvg = `/favicon-${fingerprint('favicon.svg')}.svg`
---

<!doctype html>
<html lang={site.locale}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />

    <Seo title={title} description={description} type={type} publishedTime={publishedTime} />

    <!--
      Icons, in the order browsers prefer them.

      `sizes="any"` on the SVG is the part that actually matters. Without it a browser
      may treat a scalable icon as a small fixed one and pick the `.ico` instead, which
      is the raster — so the mark you design is not necessarily the mark you get. The
      PNG is declared for the browsers that want one explicit size, and the `.ico`
      carries no `type` on purpose: it is the fallback of last resort, and every
      browser that reaches it already knows how to read one.

      `apple-touch-icon` was missing entirely. iOS ignores both SVG and ICO for the home
      screen, so without this line adding the site to your home screen on a phone gave
      you whatever the system fell back to. The file is generated with the page
      background painted behind it, because iOS composites an icon with no alpha onto
      an opaque white sheet and a light glyph on white is invisible.

      `theme-color` is `--ctp-base`. Without it Chrome's mobile address bar is white,
      which is a white bar above a near-black site; this is the one declaration that
      makes the browser chrome agree with the page.

      The hashed name on the SVG href is the fingerprint built in the frontmatter. It is
      what stops a changed icon from being invisible behind a cache: a bare path is
      never re-fetched, so a new logo would never reach anyone whose tab had already
      loaded the page once.
    -->
    <link rel="icon" type="image/svg+xml" sizes="any" href={iconSvg} />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
    <link rel="icon" href="/favicon.ico" sizes="16x16 32x32 48x48" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <meta name="theme-color" content="#1e1e2e" />
    <link rel="sitemap" href="/sitemap-index.xml" />

    <ClientRouter />

    <style is:global set:html={palette} />
  </head>

  <body>
    <a class="skip-link" href="#main">Skip to content</a>

    <div class="shell">
      <SiteNav />

      <main id="main" class="shell__main" tabindex="-1">
        <slot />
      </main>

      <SiteFooter />
    </div>
  </body>
</html>

<style>
  /* One width for the whole shell, measured in character cells, so the nav, the main
     column and the footer all start and end on the same column of the grid. This is the
     same `ch` unit `Panel` measures its frame in.

     88 -> 130, AND THE REASON IS NOT "IT LOOKED NICER WIDER". The shell was 88 cells
     because the reading column is 88 cells, and a page that is exactly as wide as its
     prose has nowhere to put anything else — every second block on the page became a
     full-width band that had to be scrolled past to reach the next one. 130 cells is
     88 of content plus a 40-cell rail and a 2-cell gutter, so the second column costs
     the reading measure NOTHING. See the layout notes in `index.astro` for the
     arithmetic and for the 53px of dead space that ruled out the obvious 94-cell
     content track.

     The two numbers below are the load-bearing ones and they are not interchangeable:
     `--content-cols` MUST stay equal to the 66ch reading measure, because a content
     track wider than the prose is a paragraph sitting short of the frame around it.
     `--rail-cols` is the slack, and it is the only part that is free to change. If a
     future edit moves `--content-cols` without moving `--measure-prose` in
     `typography.css` to match, the text and its container stop agreeing and the whole
     grid is off by the difference.

     `wide` is gone. A case study used to ask for a second, wider shell so the reading
     column had room; every page is that wide now, so the prop had nothing left to
     switch. */
  .shell {
    --shell-cols: 130;
    /* The reading column. 88 cells at 15px is 773.44px measured in a browser, which is
       66ch at 20px to the same measurement — the two figures the whole grid rests on.

       Used as a LENGTH, not left to arithmetic. The pages declare the content track as
       `minmax(0, calc(var(--content-cols) * 1ch))` rather than `1fr`, so "the reading
       column is exactly the reading measure" is a structural fact and not a subtraction
       that happens to work out while the three numbers stay in step. Change it and the
       prose stops filling its column. */
    --content-cols: 88;
    /* The rail. Slack, and a sidebar width rather than a round number picked for looks:
       40 cells is 351.56px. The widest value in the Facts block, `Built`, is 35
       characters, so it wraps to two lines there — which is what a sidebar does with a
       long value, and the reason the block is framed is so the wrap reads as a table
       rather than as a broken line. */
    --rail-cols: 40;
    --gutter-cols: 2;

    /* Where a sticky element parks, so the nav and the page rails cannot disagree.

       DERIVED, NOT CHOSEN. The nav is a `Panel` with `--panel-pad-block: 0.7em` around
       one line of 15px text at `--leading-chrome`, and it measures 88.5px tall in a
       browser. A rail sharing the nav's own `top` would slide underneath it, so the
       rail's offset is that height plus a little air: 11.5ch is 101.07px, which clears
       the stuck nav by 12.57px — measured, not asserted, on a built page scrolled to
       the point where both elements are parked. Re-measure the two numbers together if
       the nav's type size or the panel's padding ever move; they are one value because
       they are one fact. */
    --sticky-top: 11.5ch;

    display: flex;
    flex-direction: column;
    gap: 2ch;
    width: min(calc(var(--shell-cols) * 1ch), 100% - 2rem);
    margin-inline: auto;
    min-height: 100svh;
    padding-block: 1.5ch 2ch;
  }

  .shell__main {
    flex: 1 0 auto;
    min-width: 0;
    padding-block: 1ch;
  }

  .shell__main:focus {
    outline: none;
  }
</style>
